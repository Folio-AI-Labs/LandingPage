---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PRODUCT_HUNT_URL } from '../consts';

const steps = [
  {
    n: '1',
    title: 'Upvote',
    body: "It's the triangle pointing up, you'll find it, don't worry.",
  },
  {
    n: '2',
    title: 'Leave a comment',
    body: 'A question is best, like "Would Folio be able to use my slide template?"',
  },
];
---

<Layout
  title="We're launching on Product Hunt today"
  description="Folio AI is live on Product Hunt. Here's how you can help us reach Product of the Day."
>
  <Nav />

  <main class="min-h-screen">
    <!-- Hero -->
    <section class="bg-ph-orange text-white px-[30px] nav:px-[60px] py-12 nav:py-16">
      <div class="max-w-[860px] mx-auto text-center">
        <span class="inline-block font-heading text-sm font-semibold tracking-wide uppercase bg-white/15 rounded-pill py-1.5 px-4 mb-6">
          Live now, Saturday 27th
        </span>

        <h1 class="font-display text-[42px] nav:text-[58px] font-normal leading-[1.1] mb-6">
          We're live on Product Hunt, and we need you!
        </h1>
        <p class="text-white/90 text-lg nav:text-xl max-w-[560px] mx-auto">
          None of this takes long, and it makes an outsized difference.
        </p>
      </div>
    </section>

    <!-- Steps -->
    <section id="how-to-help" class="px-[30px] nav:px-[60px] pt-12 nav:pt-14 pb-20 nav:pb-24">
      <div class="max-w-[1100px] mx-auto">
        <div class="grid grid-cols-1 nav:grid-cols-2 gap-6 items-stretch max-w-[760px] mx-auto">
          {steps.map(step => (
            <div class="flex flex-col bg-white border border-brand-border rounded-2xl p-7 nav:p-8 transition duration-300 hover:border-ph-orange hover:shadow-md">
              <div class="flex items-center gap-4 mb-2">
                <span class="flex items-center justify-center w-12 h-12 shrink-0 rounded-full bg-ph-orange/10 text-ph-orange font-display text-2xl font-semibold">
                  {step.n}
                </span>
                <h3 class="font-display text-2xl nav:text-[26px] font-normal text-brand">{step.title}</h3>
              </div>
              <p class="text-brand-muted leading-[1.8]">{step.body}</p>
            </div>
          ))}
        </div>

        <div class="text-center mt-12 nav:mt-14">
          <a
            href={PRODUCT_HUNT_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 bg-ph-orange text-white no-underline font-heading font-semibold text-xl nav:text-2xl py-4 nav:py-5 px-10 nav:px-14 rounded-pill transition duration-300 hover:-translate-y-0.5 hover:shadow-xl"
          >
            Let's go
            <span aria-hidden="true" class="text-2xl nav:text-3xl">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
