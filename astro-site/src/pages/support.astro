---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Support — Verso AI" description="Get help with Verso AI. Contact our team for questions, feedback, or support.">
  <Nav />

  <main class="min-h-screen px-[30px] nav:px-[60px] py-20 flex items-center">
    <div class="max-w-[640px] mx-auto w-full">
      <div class="text-center mb-12">
        <h1 class="font-display text-[42px] nav:text-[54px] font-normal leading-tight text-brand mb-4">How can we help?</h1>
        <p class="text-base text-brand-muted">Send us a message and we'll get back to you as soon as possible.</p>
      </div>

      <form action="https://formsubmit.co/adrien@get-verso.ai" method="POST" class="space-y-6">
        <input type="hidden" name="_subject" value="New support request from get-verso.ai" />
        <input type="hidden" name="_next" value="https://get-verso.ai/support/?sent=1" />
        <input type="text" name="_honey" style="display:none" />

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-brand mb-2">Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-brand mb-2">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-sm font-semibold text-brand mb-2">Subject</label>
          <input type="text" id="subject" name="subject" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-brand mb-2">Message</label>
          <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-xl border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm resize-y"></textarea>
        </div>

        <button type="submit" class="w-full bg-brand text-white px-7 py-3.5 rounded-pill font-medium text-base transition hover:-translate-y-0.5 hover:shadow-lg">
          Send Message
        </button>
      </form>

      <div id="success-msg" class="hidden mt-8 p-6 bg-brand/5 rounded-xl text-center">
        <div class="text-brand font-bold text-lg mb-1">Message sent!</div>
        <p class="text-brand-muted text-sm">We'll get back to you shortly.</p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  if (new URLSearchParams(window.location.search).has('sent')) {
    document.getElementById('success-msg')?.classList.remove('hidden');
  }
</script>