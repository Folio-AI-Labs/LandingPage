---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SUPPORT_FORM_URL } from '../consts';
---

<Layout title="Support" description="Get help with Verso AI. Contact our team for questions, feedback, or support.">
  <Nav activePage="Support" />

  <main class="min-h-screen px-[30px] nav:px-[60px] py-20">
    <div class="max-w-[1200px] mx-auto w-full">
      <div class="text-center mb-12">
        <h1 class="font-display text-[42px] nav:text-[54px] font-normal leading-tight text-brand mb-4">How can we help?</h1>
      </div>

      <!-- FAQ Section -->
      <div class="mb-16">
        <h2 class="font-display text-[28px] nav:text-[36px] font-normal text-brand mb-8 text-center">Frequently Asked Questions</h2>

        <div class="grid grid-cols-1 nav:grid-cols-2 gap-6 items-start">
          <!-- Getting Started -->
          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              How do I get started with Verso AI?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Getting started is simple! Install Verso AI from the Microsoft Office Store, open PowerPoint, and look for the Verso AI add-in in your ribbon. Sign in with your account, and you're ready to start creating presentations with AI assistance.</p>
              </div>
            </div>
          </details>

          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              What can Verso AI do in PowerPoint?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Verso AI can create entire presentations from prompts, edit existing slides, apply professional designs, generate content, optimize layouts, maintain brand consistency, and help you iterate on your presentations. It works natively in PowerPoint, so all edits are made directly in your presentation.</p>
              </div>
            </div>
          </details>

          <!-- Technical Questions -->
          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              Which versions of PowerPoint are supported?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Verso AI works with PowerPoint for Microsoft 365, PowerPoint 2021, PowerPoint 2019, and PowerPoint on the web. Both Windows and Mac versions are fully supported.</p>
              </div>
            </div>
          </details>

          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              Does Verso AI work offline?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Verso AI requires an internet connection to generate and process AI content. However, once slides are created, you can continue editing them in PowerPoint offline as usual.</p>
              </div>
            </div>
          </details>

          <!-- Pricing & Plans -->
          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              What pricing plans are available?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">We offer flexible plans for individuals and teams. Start with our free trial to test all features. For pricing details and enterprise plans with custom features, advanced security, and dedicated support, please contact our sales team.</p>
              </div>
            </div>
          </details>

          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              Can I cancel my subscription anytime?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Yes, you can cancel your subscription at any time. Your access will continue until the end of your current billing period, and you won't be charged again.</p>
              </div>
            </div>
          </details>

          <!-- Privacy & Security -->
          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              Is my data secure and private?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Absolutely. We take data security seriously. Your presentations and data are encrypted in transit and at rest. We never train our AI models on your content, and we're compliant with enterprise security standards including SOC 2 and GDPR.</p>
              </div>
            </div>
          </details>

          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              Can I use Verso AI for commercial presentations?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Yes! All content generated by Verso AI is yours to use commercially. You retain full ownership and rights to your presentations and any AI-generated content within them.</p>
              </div>
            </div>
          </details>

          <!-- Enterprise & Team -->
          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              Do you offer team or enterprise plans?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Yes! Our enterprise plan includes centralized billing, team management, brand template libraries, advanced security features, SSO integration, dedicated support, and custom AI model configurations. Contact us for a demo tailored to your organization's needs.</p>
              </div>
            </div>
          </details>

          <!-- Troubleshooting -->
          <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
            <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
              The add-in isn't showing up in PowerPoint. What should I do?
              <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
            </summary>
            <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
              <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
                <p class="px-6 pb-4 text-brand-muted leading-[1.8]">Try these steps: 1) Restart PowerPoint completely, 2) Check that you're signed in to your Microsoft account, 3) Go to Insert > Get Add-ins and verify Verso AI is installed, 4) Check your IT department hasn't blocked add-ins. If issues persist, contact our support team.</p>
              </div>
            </div>
          </details>
        </div>

        <div class="mt-8 text-center">
          <p class="text-brand-muted text-sm">Can't find what you're looking for? Send us a message using the form below.</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="mt-16 max-w-[640px] mx-auto">
        <h2 class="font-display text-[28px] nav:text-[36px] font-normal text-brand mb-8 text-center">Send us a message</h2>

      <form id="supportForm" data-action={SUPPORT_FORM_URL} class="space-y-6">

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-brand mb-2">Name</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-brand mb-2">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-sm font-semibold text-brand mb-2">Subject</label>
          <input type="text" id="subject" name="subject" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-brand mb-2">Message</label>
          <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-xl border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm resize-y"></textarea>
        </div>

        <button type="submit" class="w-full bg-brand text-white px-7 py-3.5 rounded-pill font-medium text-base transition hover:-translate-y-0.5 hover:shadow-lg">
          Send Message
        </button>
      </form>

      <div id="success-msg" class="hidden mt-8 p-6 bg-brand/5 rounded-xl text-center">
        <div class="text-brand font-bold text-lg mb-1">Message sent!</div>
        <p class="text-brand-muted text-sm">We'll get back to you shortly.</p>
      </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const supportForm = document.getElementById('supportForm') as HTMLFormElement;
  supportForm?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const url = supportForm.dataset.action!;
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const subject = (document.getElementById('subject') as HTMLInputElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value;
    const submitBtn = supportForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;

    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ name, email, subject, message }),
    });

    if (response.ok) {
      supportForm.style.display = 'none';
      (document.getElementById('success-msg') as HTMLElement).classList.remove('hidden');
    } else {
      submitBtn.disabled = false;
      alert('Something went wrong. Please try again or email us at contact@get-verso.ai.');
    }
  });

  // FAQ smooth open/close
  const faqItems = document.querySelectorAll('details');

  function closeFaq(item: HTMLDetailsElement) {
    item.classList.remove('expanded');
    item.querySelector('.faq-content')?.addEventListener('transitionend', () => {
      item.open = false;
    }, { once: true });
  }

  faqItems.forEach(item => {
    item.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();

      if (item.classList.contains('expanded')) {
        closeFaq(item as HTMLDetailsElement);
      } else {
        faqItems.forEach(other => {
          if (other !== item && other.classList.contains('expanded')) {
            closeFaq(other as HTMLDetailsElement);
          }
        });
        (item as HTMLDetailsElement).open = true;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            item.classList.add('expanded');
          });
        });
      }
    });
  });
</script>
