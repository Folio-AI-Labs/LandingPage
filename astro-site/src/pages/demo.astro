---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import { DEMO_BOOKING_URL } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('demo.metaTitle')} description={t('demo.metaDescription')}>

  <section class="min-h-screen flex flex-col justify-center items-center py-[60px] px-[30px] nav:py-20 nav:px-[60px] relative overflow-hidden">
    <div class="absolute inset-0 bg-center bg-[length:100%] opacity-50 z-0" style="background-image: url('/monet8.jpg')"></div>
    <div class="max-w-[600px] w-full bg-white rounded-2xl py-10 px-[30px] nav:p-[60px] border-2 border-brand-border shadow-md relative z-10 text-center">
      <h1 class="font-display text-[32px] nav:text-[42px] font-normal leading-tight text-brand mb-4">{t('demo.title')}</h1>
      <p class="text-lg leading-relaxed text-brand-muted mb-10">{t('demo.subtitle')}</p>

      <a
        href={DEMO_BOOKING_URL}
        target="_blank"
        rel="noopener"
        class="inline-block w-full bg-brand text-white py-4 px-8 rounded-pill text-base font-semibold no-underline transition duration-300 hover:-translate-y-0.5 hover:shadow-lg"
      >
        {t('demo.submitButton')}
      </a>

      <a href={getLocalizedPath('/', lang)} class="block mt-6 font-heading text-sm text-brand-muted no-underline transition-colors duration-300 hover:text-brand">{t('demo.backToHomepage')}</a>
    </div>
  </section>

  <Footer />
</Layout>
