---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('pricing.metaTitle')} description={t('pricing.metaDescription')}>
  <Nav activePage={t('nav.pricing')} />

  <!-- Pricing Section -->
  <section class="min-h-screen pt-[80px] px-[30px] pb-[40px] nav:pt-[80px] nav:pb-[40px] nav:px-[60px]">
    <div class="text-center mb-8">
      <h1 class="font-display text-[42px] nav:text-[64px] font-normal leading-tight text-brand mb-6">{t('pricing.title')}</h1>
      <p class="font-display text-[18px] nav:text-[20px] leading-relaxed text-brand-dark max-w-[600px] mx-auto">{t('pricing.subtitle')}<br />{t('pricing.subtitle2')}</p>
    </div>

    <!-- Pricing Cards -->
    <div class="max-w-[1600px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">

      <!-- Starter Plan -->
      <div class="bg-white rounded-2xl px-6 py-5 border-2 border-brand-border transition duration-300 flex flex-col hover:-translate-y-2 hover:shadow-xl hover:border-brand">
        <div class="mb-3 min-h-[90px]">
          <div class="flex items-center gap-3 mb-1">
            <h3 class="font-display text-[28px] font-semibold text-brand">{t('pricing.starter.name')}</h3>
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.starter.description')}</p>
        </div>

        <div class="mb-3 min-h-[56px]">
          <div class="flex items-baseline gap-1 flex-wrap">
            <span class="text-[28px] sm:text-[32px] lg:text-[40px] font-bold text-brand font-display">$0</span>
            <span class="text-sm text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl px-3 py-3 mb-4">
          <p class="text-sm leading-tight text-brand-dark"><span class="font-semibold text-brand">{t('pricing.starter.credits')}</span> {t('pricing.starter.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.starter.creditPrice')}</span> {t('pricing.starter.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-5 flex-grow">
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature1')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature2')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature3')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature4')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature5')}</li>
        </ul>

        <button data-open-install-modal class="block w-full py-3 rounded-pill text-center text-[14px] font-semibold transition duration-300 cursor-pointer border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white">{t('pricing.getStarted')}</button>
      </div>

      <!-- Plus Plan -->
      <div class="bg-white rounded-2xl px-4 py-5 border-2 border-brand-border transition duration-300 flex flex-col hover:-translate-y-2 hover:shadow-xl hover:border-brand">
        <div class="mb-3 min-h-[90px]">
          <div class="flex items-center gap-3 mb-1">
            <h3 class="font-display text-[28px] font-semibold text-brand">{t('pricing.plus.name')}</h3>
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.plus.description')}</p>
        </div>

        <div class="mb-3 min-h-[56px]">
          <div class="flex items-baseline gap-1 flex-wrap">
            <span class="text-[28px] sm:text-[32px] lg:text-[40px] font-bold text-brand font-display">$49</span>
            <span class="text-sm text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl px-3 py-3 mb-4">
          <p class="text-sm leading-tight text-brand-dark"><span class="font-semibold text-brand">{t('pricing.plus.credits')}</span> {t('pricing.plus.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.plus.creditPrice')}</span> {t('pricing.plus.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-5 flex-grow">
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span><strong>{t('pricing.plus.feature1')}</strong></li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.plus.feature2')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.plus.feature3')}</li>
        </ul>

        <button data-open-install-modal class="block w-full py-3 rounded-pill text-center text-[14px] font-semibold transition duration-300 cursor-pointer border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white">{t('pricing.getStarted')}</button>
      </div>

      <!-- Pro Plan -->
      <div class="bg-white rounded-2xl px-4 py-5 border-2 border-brand transition duration-300 flex flex-col relative hover:-translate-y-2 hover:shadow-xl">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand text-white py-1.5 px-4 rounded-[20px] text-[10px] font-bold tracking-[0.5px] uppercase whitespace-nowrap">{t('pricing.mostPopular')}</span>
        <div class="mb-3 min-h-[90px]">
          <div class="flex items-center gap-3 mb-1">
            <h3 class="font-display text-[28px] font-semibold text-brand">{t('pricing.pro.name')}</h3>
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.pro.description')}</p>
        </div>

        <div class="mb-3 min-h-[56px]">
          <div class="flex items-baseline gap-1 flex-wrap">
            <span class="text-[28px] sm:text-[32px] lg:text-[40px] font-bold text-brand font-display">$199</span>
            <span class="text-sm text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl px-3 py-3 mb-4">
          <p class="text-sm leading-tight text-brand-dark"><span class="font-semibold text-brand">{t('pricing.pro.credits')}</span> {t('pricing.pro.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.pro.creditPrice')}</span> {t('pricing.pro.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-5 flex-grow">
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span><strong>{t('pricing.pro.feature1')}</strong></li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.pro.feature2')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.pro.feature3')}</li>
        </ul>

        <button data-open-install-modal class="block w-full py-3 rounded-pill text-center text-[14px] font-semibold transition duration-300 cursor-pointer bg-brand text-white border-none hover:bg-opacity-90">{t('pricing.getStarted')}</button>
      </div>

      <!-- Ultimate Plan -->
      <div class="bg-white rounded-2xl px-4 py-5 border-2 border-brand-border transition duration-300 flex flex-col hover:-translate-y-2 hover:shadow-xl hover:border-brand">
        <div class="mb-3 min-h-[90px]">
          <div class="flex items-center gap-3 mb-1">
            <h3 class="font-display text-[28px] font-semibold text-brand">{t('pricing.ultimate.name')}</h3>
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.ultimate.description')}</p>
        </div>

        <div class="mb-3 min-h-[56px]">
          <div class="flex items-baseline gap-1 flex-wrap">
            <span class="text-[28px] sm:text-[32px] lg:text-[40px] font-bold text-brand font-display">$499</span>
            <span class="text-sm text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl px-3 py-3 mb-4">
          <p class="text-sm leading-tight text-brand-dark"><span class="font-semibold text-brand">{t('pricing.ultimate.credits')}</span> {t('pricing.ultimate.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.ultimate.creditPrice')}</span> {t('pricing.ultimate.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-5 flex-grow">
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span><strong>{t('pricing.ultimate.feature1')}</strong></li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.ultimate.feature2')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.ultimate.feature3')}</li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.ultimate.feature4')}</li>
        </ul>

        <button data-open-install-modal class="block w-full py-3 rounded-pill text-center text-[14px] font-semibold transition duration-300 cursor-pointer border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white">{t('pricing.getStarted')}</button>
      </div>

      <!-- Unlimited Plan -->
      <div class="rounded-2xl px-6 py-5 transition duration-300 flex flex-col hover:-translate-y-2 hover:shadow-xl bg-cover bg-center" style="background-image: url('/unlimited_bg.webp');">
        <div class="mb-3 min-h-[90px]">
          <div class="flex items-center gap-3 mb-1">
            <h3 class="font-display text-[28px] font-semibold text-white">{t('pricing.unlimited.name')}</h3>
          </div>
          <p class="text-sm text-white leading-normal">{t('pricing.unlimited.description')}</p>
        </div>

        <div class="mb-3 min-h-[56px] flex items-center">
          <a href={getLocalizedPath('/quote', lang)} class="block w-full py-3 rounded-pill text-center no-underline text-[14px] font-semibold transition duration-300 cursor-pointer bg-black text-white hover:bg-gray-800">{t('pricing.unlimited.getQuote')}</a>
        </div>

        <div class="bg-brand-bg rounded-xl px-3 py-3 mb-4">
          <p class="text-sm leading-tight text-brand-dark"><span class="font-semibold text-brand">{t('pricing.unlimited.credits')}</span> {t('pricing.unlimited.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark">&nbsp;</p>
        </div>

        <ul class="list-none mb-5 flex-grow">
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-white"><span class="text-white font-bold text-base shrink-0">✓</span><strong>{t('pricing.unlimited.feature1')}</strong></li>
          <li class="flex items-start gap-2 mb-2 text-sm leading-relaxed text-white"><span class="text-white font-bold text-base shrink-0">✓</span>{t('pricing.unlimited.feature2')}</li>
        </ul>
      </div>

    </div>

    <!-- FAQ Section -->
    <div class="max-w-[1200px] mx-auto mt-12">
      <h2 class="font-display text-[34px] font-semibold text-center mb-8 text-brand">{t('pricing.faq.title')}</h2>

      <div class="grid grid-cols-1 nav:grid-cols-2 gap-6 items-start">
        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q1')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a1')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q2')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a2')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q3')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a3')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q4')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a4')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q5')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a5')}</p>
            </div>
          </div>
        </details>
      </div>
    </div>

  </section>

  <CtaBanner />
  <Footer />
</Layout>

<script>
  // FAQ smooth open/close
  const faqItems = document.querySelectorAll('details');

  function closeFaq(item: HTMLDetailsElement) {
    item.classList.remove('expanded');
    item.querySelector('.faq-content')?.addEventListener('transitionend', () => {
      item.open = false;
    }, { once: true });
  }

  faqItems.forEach(item => {
    item.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();

      if (item.classList.contains('expanded')) {
        closeFaq(item as HTMLDetailsElement);
      } else {
        faqItems.forEach(other => {
          if (other !== item && other.classList.contains('expanded')) {
            closeFaq(other as HTMLDetailsElement);
          }
        });
        (item as HTMLDetailsElement).open = true;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            item.classList.add('expanded');
          });
        });
      }
    });
  });
</script>
