---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import PerformanceChart from '../../components/PerformanceChart.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('meta.title')} description={t('meta.description')}>
  <Nav activePage={t('nav.home')} />

  <!-- Hero Section -->
  <section class="min-h-[calc(100vh-50px)] grid grid-rows-[0.5fr_auto_3fr] px-[30px] nav:px-[60px] relative">
    <div></div>
    <div class="max-w-[1080px] w-[90%] bg-gradient-to-br from-[rgba(230,235,240,0.4)] to-[rgba(240,230,235,0.4)] rounded-3xl py-10 px-[30px] nav:py-[39px] nav:px-[72px] text-center relative overflow-hidden mx-auto self-center">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.35] z-0" style="background-image: url('/monet.webp')"></div>
      <h1 class="relative z-10 font-display text-[42px] nav:text-[64px] font-normal leading-tight text-brand mb-8">{t('hero.title')}</h1>
      <div class="relative z-10 font-display text-[18px] nav:text-[20px] leading-relaxed text-brand-dark mb-12 mx-auto text-center">
        <div class="whitespace-nowrap">{t('hero.subtitle1')}</div>
        <div class="whitespace-nowrap">{t('hero.subtitle2')}</div>
      </div>
      <div class="relative z-10 flex flex-col nav:flex-row gap-3 nav:gap-4 justify-center items-center">
        <a href="https://verso.fly.dev/playground/" class="w-full nav:w-auto inline-block bg-brand text-white py-4 px-10 rounded-pill no-underline text-sm font-medium transition duration-300 hover:-translate-y-0.5 hover:shadow-lg text-center">{t('nav.getStarted')}</a>
        <a href={getLocalizedPath('/demo/', lang)} class="w-full nav:w-auto inline-block bg-brand-bg text-brand border-2 border-brand py-4 px-10 rounded-pill no-underline text-sm font-medium transition duration-300 hover:bg-brand hover:text-white hover:-translate-y-0.5 hover:shadow-lg text-center">{t('nav.bookDemo')}</a>
      </div>

      <div class="relative z-10 mt-[60px] text-center">
        <h3 class="text-[11px] font-semibold tracking-[2px] uppercase text-brand-muted mb-6">{t('hero.trustedBy')}</h3>
        <div class="flex justify-center items-center gap-[42px] flex-wrap">
          <img src="/mckinsey.png" alt="McKinsey" class="h-8 opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" />
          <img src="/bcg.png" alt="BCG" class="h-[28px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" />
          <img src="/kearney.png" alt="Kearney" class="h-[20px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" />
          <img src="/bain.webp" alt="Bain" class="h-[28px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" />
          <img src="/ey.png" alt="EY" class="h-[38px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" />
          <img src="/bnp.png" alt="BNP Paribas" class="h-[58px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" />
        </div>
      </div>
    </div>
    <div></div>
  </section>

  <!-- Intelligence Section -->
  <section class="py-[60px] px-[30px] nav:py-20 nav:px-[60px] bg-white" id="intelligence">
    <div class="max-w-[1200px] mx-auto text-center">
      <h2 class="font-display text-[36px] nav:text-[48px] font-normal leading-tight text-brand mb-5">{t('intelligence.title')}</h2>
      <p class="text-lg leading-relaxed text-brand-muted mb-10 max-w-narrow mx-auto">{t('intelligence.subtitle')}<br />{t('intelligence.subtitleCta')}</p>

      <div class="grid grid-cols-1 nav:grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-10">
        <div class="text-center p-[30px]">
          <div class="w-full h-[240px] bg-[#e8e8e8] rounded-2xl mb-8 overflow-hidden flex items-center justify-center border-2 border-brand-border"></div>
          <h3 class="font-heading text-2xl font-semibold mb-4 text-brand">{t('intelligence.feature1.title')}</h3>
          <p class="text-base leading-relaxed text-brand-muted">{t('intelligence.feature1.desc')}</p>
        </div>
        <div class="text-center p-[30px]">
          <div class="w-full h-[240px] bg-[#e8e8e8] rounded-2xl mb-8 overflow-hidden flex items-center justify-center border-2 border-brand-border"></div>
          <h3 class="font-heading text-2xl font-semibold mb-4 text-brand">{t('intelligence.feature2.title')}</h3>
          <p class="text-base leading-relaxed text-brand-muted">{t('intelligence.feature2.desc')}</p>
        </div>
        <div class="text-center p-[30px]">
          <div class="w-full h-[240px] bg-[#e8e8e8] rounded-2xl mb-8 overflow-hidden flex items-center justify-center border-2 border-brand-border"></div>
          <h3 class="font-heading text-2xl font-semibold mb-4 text-brand">{t('intelligence.feature3.title')}</h3>
          <p class="text-base leading-relaxed text-brand-muted">{t('intelligence.feature3.desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities Section -->
  <section class="py-[60px] px-[30px] nav:py-20 nav:px-[60px] bg-gradient-to-br from-[rgba(230,235,240,0.3)] to-[rgba(240,230,235,0.3)]">
    <div class="max-w-[1200px] mx-auto">
      <h2 class="font-display text-[36px] nav:text-[48px] font-normal leading-tight text-brand mb-[60px] text-center">{t('capabilities.title')}</h2>

      <div class="grid grid-cols-1 nav:grid-cols-2 gap-[30px] nav:gap-[60px] mb-10 nav:mb-[60px] items-center">
        <div>
          <h3 class="font-heading text-2xl nav:text-[32px] font-semibold mb-4 text-brand">{t('capabilities.prompt.title')}</h3>
          <p class="text-base nav:text-lg leading-[1.8] text-brand-muted">{t('capabilities.prompt.desc')}</p>
        </div>
        <div class="bg-white rounded-2xl p-10 nav:p-[60px] border-2 border-brand-border min-h-[200px] nav:min-h-[300px] flex items-center justify-center">
          <div class="w-full h-full bg-brand-bg rounded-xl flex items-center justify-center text-brand-light text-sm"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 nav:grid-cols-2 gap-[30px] nav:gap-[60px] mb-10 nav:mb-[60px] items-center">
        <div class="nav:order-2">
          <h3 class="font-heading text-2xl nav:text-[32px] font-semibold mb-4 text-brand">{t('capabilities.design.title')}</h3>
          <p class="text-base nav:text-lg leading-[1.8] text-brand-muted">{t('capabilities.design.desc')}</p>
        </div>
        <div class="nav:order-1 bg-white rounded-2xl p-10 nav:p-[60px] border-2 border-brand-border min-h-[200px] nav:min-h-[300px] flex items-center justify-center">
          <div class="w-full h-full bg-brand-bg rounded-xl flex items-center justify-center text-brand-light text-sm"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 nav:grid-cols-2 gap-[30px] nav:gap-[60px] mb-10 nav:mb-[60px] items-center">
        <div>
          <h3 class="font-heading text-2xl nav:text-[32px] font-semibold mb-4 text-brand">{t('capabilities.iterate.title')}</h3>
          <p class="text-base nav:text-lg leading-[1.8] text-brand-muted">{t('capabilities.iterate.desc')}</p>
        </div>
        <div class="bg-white rounded-2xl p-10 nav:p-[60px] border-2 border-brand-border min-h-[200px] nav:min-h-[300px] flex items-center justify-center">
          <div class="w-full h-full bg-brand-bg rounded-xl flex items-center justify-center text-brand-light text-sm"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 nav:grid-cols-2 gap-[30px] nav:gap-[60px] mb-10 nav:mb-[60px] items-center">
        <div class="nav:order-2">
          <h3 class="font-heading text-2xl nav:text-[32px] font-semibold mb-4 text-brand">{t('capabilities.integration.title')}</h3>
          <p class="text-base nav:text-lg leading-[1.8] text-brand-muted">{t('capabilities.integration.desc')}</p>
        </div>
        <div class="nav:order-1 bg-white rounded-2xl p-10 nav:p-[60px] border-2 border-brand-border min-h-[200px] nav:min-h-[300px] flex items-center justify-center">
          <div class="w-full h-full bg-brand-bg rounded-xl flex items-center justify-center text-brand-light text-sm"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 nav:grid-cols-2 gap-[30px] nav:gap-[60px] items-center">
        <div>
          <h3 class="font-heading text-2xl nav:text-[32px] font-semibold mb-4 text-brand">{t('capabilities.enterprise.title')}</h3>
          <p class="text-base nav:text-lg leading-[1.8] text-brand-muted">{t('capabilities.enterprise.desc')}</p>
        </div>
        <div class="bg-white rounded-2xl p-10 nav:p-[60px] border-2 border-brand-border min-h-[200px] nav:min-h-[300px] flex items-center justify-center">
          <div class="w-full h-full bg-brand-bg rounded-xl flex items-center justify-center text-brand-light text-sm"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Models Section -->
  <section class="py-[60px] px-[30px] nav:py-20 nav:px-[60px] bg-white" id="models">
    <div class="max-w-[1200px] mx-auto text-center">
      <h2 class="font-display text-[36px] nav:text-[48px] font-normal leading-tight text-brand mb-10">{t('models.title')}</h2>
      <p class="text-lg leading-[1.8] text-brand-muted max-w-[900px] mx-auto mb-10">{t('models.desc')}</p>
      <PerformanceChart />
    </div>
  </section>

  <CtaBanner />
  <Footer />
</Layout>
