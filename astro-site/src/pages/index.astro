---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import PerformanceChart from '../components/PerformanceChart.astro';
import DemoFrame from '../components/DemoFrame.astro';
import AddinDemo from '../components/demo/AddinDemo';
import PromptToDeckDemo from '../components/demo/PromptToDeckDemo';
import EditDeckDemo from '../components/demo/EditDeckDemo';
import FullControlDemo from '../components/demo/FullControlDemo';
import UploadFilesDemo from '../components/demo/UploadFilesDemo';
import SSODemo from '../components/demo/SSODemo';
import EnterpriseDemo from '../components/demo/EnterpriseDemo';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Toggle "Trusted by" section visibility - set to true to show, false to hide
const showTrustedBy = false;
---

<Layout title={t('meta.title')} description={t('meta.description')}>
  <Nav activePage={t('nav.home')} />

  <main>
  <!-- Hero Section + Demo overlapping -->
  <section class="relative px-0 bg-white">
    <!-- Impressionist painting card -->
    <div class="max-w-[1400px] w-[95%] bg-gradient-to-br from-[rgba(240,242,245,0.6)] to-[rgba(245,240,242,0.6)] rounded-3xl py-6 px-[16px] nav:py-[39px] nav:px-[72px] text-center relative overflow-hidden mx-auto mt-0 nav:mt-10" style="margin-bottom: -280px;">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.3] z-0" style="background-image: url('/monet.webp')"></div>
      <h1 class="relative z-10 font-display text-[42px] nav:text-[64px] font-normal leading-tight text-brand mb-4">{t('hero.title')}</h1>
      <p class="relative z-10 font-display text-[18px] nav:text-[20px] leading-relaxed text-brand-dark mb-2">{t('hero.subtitle1')}<sup><a href="#models" class="text-brand hover:underline ml-0.5">[1]</a></sup></p>
      <p class="relative z-10 font-display text-[18px] nav:text-[20px] leading-relaxed text-brand-dark mb-6">{t('hero.subtitle2')}</p>
      <!-- CTA buttons on Monet background -->
      <div class="relative z-10 flex flex-col nav:flex-row gap-3 nav:gap-4 justify-center items-center mb-0">
        <button data-open-install-modal class="w-full max-w-[240px] nav:w-auto inline-block bg-brand text-white py-4 px-10 rounded-pill border-none text-sm font-medium cursor-pointer transition duration-300 hover:-translate-y-0.5 hover:shadow-lg text-center">{t('nav.getStarted')}</button>
        <a href={getLocalizedPath('/demo/', lang)} class="w-full max-w-[240px] nav:w-auto inline-block bg-brand-bg text-brand border-2 border-brand py-4 px-10 rounded-pill no-underline text-sm font-medium transition duration-300 hover:bg-brand hover:text-white hover:-translate-y-0.5 hover:shadow-lg text-center">{t('nav.bookDemo')}</a>
      </div>
      <!-- Spacer for the overlap -->
      <div class="relative z-10" style="height: 300px;"></div>
    </div>

    <!-- Demo Animation — overlaps bottom half of hero card -->
    <div class="relative z-10" id="demo-animation" style="max-width: 1200px; margin: -312px auto 0;">
      <AddinDemo lang={lang} client:visible />
    </div>
  </section>

  <!-- Trusted by -->
  {showTrustedBy ? (
  <section class="py-8 px-[12px] nav:px-[60px]">
    <div class="max-w-[960px] mx-auto text-center">
      <p class="text-[11px] font-semibold tracking-[2px] uppercase text-brand-muted mb-6">{t('hero.trustedBy')}</p>
      <div class="flex justify-center items-center gap-[42px] flex-wrap">
        <img src="/mckinsey.webp" alt="McKinsey" width="103" height="32" class="h-8 opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" loading="lazy" />
        <img src="/bcg.webp" alt="BCG" width="70" height="28" class="h-[28px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" loading="lazy" />
        <img src="/kearney.webp" alt="Kearney" width="166" height="20" class="h-[20px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" loading="lazy" />
        <img src="/bain.webp" alt="Bain" width="92" height="28" class="h-[28px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" loading="lazy" />
        <img src="/ey.webp" alt="EY" width="38" height="38" class="h-[38px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" loading="lazy" />
        <img src="/bnp.webp" alt="BNP Paribas" width="103" height="58" class="h-[58px] opacity-80 transition-opacity duration-300 hover:opacity-100" style="filter: brightness(0);" loading="lazy" />
      </div>
    </div>
  </section>
  ) : (
  <section class="py-8 px-[12px] nav:px-[60px] bg-white" aria-hidden="true">
    <!-- Spacer to maintain layout when Trusted by is hidden -->
  </section>
  )}

  <!-- Features Section -->
  <section class="py-[60px] px-[12px] nav:py-20 nav:px-[60px] bg-[#f5f5f5]" id="features" style="clear: both;">
    <div class="max-w-[1200px] mx-auto">
      <h2 class="font-display text-[36px] nav:text-[48px] font-normal leading-tight text-brand mb-8 nav:mb-10 text-center">{t('features.title')}</h2>

      <!-- Example decks -->
      <div class="bg-white rounded-xl shadow-md p-5 nav:p-8 mb-12 nav:mb-16">
        <p class="text-base nav:text-lg text-brand-muted text-center mb-6 nav:mb-8">{t('examples.subtitle')}</p>
        <div class="grid grid-cols-1 nav:grid-cols-3 gap-6 nav:gap-8">
          <a href="https://get-verso.ai/draghi-report-summary-deck" target="_blank" rel="noopener" class="group block no-underline w-full max-w-[300px] mx-auto nav:max-w-none">
            <img src="/decks/draghi.png" alt={t('examples.draghi')} loading="lazy" class="block w-full aspect-[16/9] object-cover rounded-lg transition-transform duration-300 group-hover:-translate-y-1" />
            <p class="mt-3 font-heading text-base font-semibold text-brand text-center transition-transform duration-300 group-hover:-translate-y-1">{t('examples.draghi')}</p>
          </a>
          <a href="https://onedrive.live.com/:p:/g/personal/CE4EA304684D49DB/IQAd8he1oQ1ES5HOtPfz-g4oAa95d4B3nnjTp2aSwi2UZEY?resid=CE4EA304684D49DB!sb517f21d0da14b4491ceb4f7f3fa0e28&ithint=file%2Cpptx&e=q7OlEm&migratedtospo=true&redeem=aHR0cHM6Ly8xZHJ2Lm1zL3AvYy9jZTRlYTMwNDY4NGQ0OWRiL0lRQWQ4aGUxb1ExRVM1SE90UGZ6LWc0b0FhOTVkNEIzbm5qVHAyYVN3aTJVWkVZP2U9cTdPbEVt" target="_blank" rel="noopener" class="group block no-underline w-full max-w-[300px] mx-auto nav:max-w-none">
            <img src="/decks/stateofai.png" alt={t('examples.stateofai')} loading="lazy" class="block w-full aspect-[16/9] object-cover rounded-lg transition-transform duration-300 group-hover:-translate-y-1" />
            <p class="mt-3 font-heading text-base font-semibold text-brand text-center transition-transform duration-300 group-hover:-translate-y-1">{t('examples.stateofai')}</p>
          </a>
          <a href="https://onedrive.live.com/:p:/g/personal/CE4EA304684D49DB/IQCGtqSqtQhAR6nsbara-guFAaZx2E7LJGSyQQDx5_hlfV0?resid=CE4EA304684D49DB!saaa4b68608b54740a9ec6daadafa0b85&ithint=file%2Cpptx&e=1nDkh9&migratedtospo=true&redeem=aHR0cHM6Ly8xZHJ2Lm1zL3AvYy9jZTRlYTMwNDY4NGQ0OWRiL0lRQ0d0cVNxdFFoQVI2bnNiYXJhLWd1RkFhWngyRTdMSkdTeVFRRHg1X2hsZlYwP2U9MW5Ea2g5" target="_blank" rel="noopener" class="group block no-underline w-full max-w-[300px] mx-auto nav:max-w-none">
            <img src="/decks/airfrance.png" alt={t('examples.airfrance')} loading="lazy" class="block w-full aspect-[16/9] object-cover rounded-lg transition-transform duration-300 group-hover:-translate-y-1" />
            <p class="mt-3 font-heading text-base font-semibold text-brand text-center transition-transform duration-300 group-hover:-translate-y-1">{t('examples.airfrance')}</p>
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-14 nav:gap-12">
        <!-- Prompt to deck - Screenshot LEFT -->
        <div class="grid grid-cols-1 nav:grid-cols-2 gap-3 nav:gap-8 items-center">
          <div class="order-2 nav:order-1">
            <DemoFrame><PromptToDeckDemo lang={lang} client:visible /></DemoFrame>
          </div>
          <div class="order-1 nav:order-2">
            <div class="flex items-center gap-3 mb-3">
              <div class="shrink-0 w-9 h-9 rounded-lg bg-brand/[0.07] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
              </div>
              <h3 class="font-heading text-2xl font-semibold text-brand">{t('features.prompt.title')}</h3>
            </div>
            <p class="text-base leading-[1.7] text-brand-muted">{t('features.prompt.desc')}</p>
          </div>
        </div>

        <!-- Edit an existing deck - Screenshot RIGHT -->
        <div class="grid grid-cols-1 nav:grid-cols-2 gap-3 nav:gap-8 items-center">
          <div class="order-2 nav:order-2">
            <DemoFrame><EditDeckDemo lang={lang} client:visible /></DemoFrame>
          </div>
          <div class="order-1 nav:order-1 nav:text-right">
            <div class="flex items-center gap-3 mb-3 nav:justify-end">
              <div class="shrink-0 w-9 h-9 rounded-lg bg-brand/[0.07] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
              </div>
              <h3 class="font-heading text-2xl font-semibold text-brand">{t('features.edit.title')}</h3>
            </div>
            <p class="text-base leading-[1.7] text-brand-muted">{t('features.edit.desc')}</p>
          </div>
        </div>

        <!-- Full control, Upload files, Enterprise-ready — grouped card -->
        <div class="bg-white rounded-xl shadow-md grid grid-cols-1 nav:grid-cols-3 gap-0 items-stretch">
          <!-- Full control -->
          <div class="px-6 nav:px-8 py-6 nav:border-r nav:border-[#ddd]">
            <div class="flex items-center gap-3 mb-3">
              <div class="shrink-0 w-9 h-9 rounded-lg bg-brand/[0.07] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M5.5 8.5 9 12l-3.5 3.5L2 12l3.5-3.5Z"/><path d="m12 2 3.5 3.5L12 9 8.5 5.5 12 2Z"/><path d="M18.5 8.5 22 12l-3.5 3.5L15 12l3.5-3.5Z"/><path d="m12 15 3.5 3.5L12 22l-3.5-3.5L12 15Z"/></svg>
              </div>
              <h3 class="font-heading text-2xl font-semibold text-brand">{t('features.control.title')}</h3>
            </div>
            <p class="text-base leading-[1.7] text-brand-muted">{t('features.control.desc')}</p>
          </div>
          <!-- Upload files -->
          <div class="px-6 nav:px-8 py-6 border-t nav:border-t-0 nav:border-r border-[#ddd]">
            <div class="flex items-center gap-3 mb-3">
              <div class="shrink-0 w-9 h-9 rounded-lg bg-brand/[0.07] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
              </div>
              <h3 class="font-heading text-2xl font-semibold text-brand">{t('features.upload.title')}</h3>
            </div>
            <p class="text-base leading-[1.7] text-brand-muted">{t('features.upload.desc')}</p>
          </div>
          <!-- Enterprise-ready -->
          <div class="px-6 nav:px-8 py-6 border-t nav:border-t-0 border-[#ddd]">
            <div class="flex items-center gap-3 mb-3">
              <div class="shrink-0 w-9 h-9 rounded-lg bg-brand/[0.07] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 .5-.87l7-4a1 1 0 0 1 1 0l7 4A1 1 0 0 1 20 6z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="font-heading text-2xl font-semibold text-brand">{t('features.enterprise.title')}</h3>
            </div>
            <p class="text-base leading-[1.7] text-brand-muted">{t('features.enterprise.desc')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Models Section -->
  <section class="py-[60px] px-[12px] nav:py-20 nav:px-[60px] bg-white" id="models">
    <div class="max-w-[1200px] mx-auto text-center">
      <h2 class="font-display text-[36px] nav:text-[48px] font-normal leading-tight text-brand mb-10">{t('models.title')}</h2>
      <p class="text-lg leading-[1.8] text-brand-muted max-w-[900px] mx-auto mb-5">{t('models.desc')}</p>
      <PerformanceChart />
    </div>
  </section>

  <CtaBanner />
  </main>
  <Footer />
</Layout>
