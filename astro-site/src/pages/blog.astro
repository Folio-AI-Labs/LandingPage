---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection, render } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const rendered = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);
---

<Layout title="Articles — Verso AI" description="Articles and research from the Verso AI team.">
  <Nav activePage="Articles" />

  <section class="max-w-3xl mx-auto pt-[120px] px-6 pb-20">
    <h1 class="font-heading text-3xl nav:text-4xl font-semibold text-brand mb-12">Articles</h1>

    {rendered.map(({ post, Content }) => (
      <article class="mb-20 prose prose-lg max-w-none
        prose-headings:font-heading prose-headings:text-brand
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-brand-muted prose-p:leading-relaxed
        prose-li:text-brand-muted
        prose-strong:text-brand
        prose-table:text-sm
        prose-th:text-left prose-th:font-semibold
        prose-td:py-1 prose-td:px-3
        prose-a:text-brand prose-a:underline">
        <p class="text-sm text-brand-muted/60 mb-2">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        <Content />
      </article>
    ))}
  </section>

  <Footer />
</Layout>
