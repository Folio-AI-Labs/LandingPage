---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Use — Verso AI" description="Terms of Use for Verso AI's PowerPoint add-in and web application.">
  <Nav />

  <main class="px-[30px] nav:px-[60px] py-20">
    <div class="max-w-[800px] mx-auto">

      <div class="text-center mb-12">
        <h1 class="font-display text-[42px] nav:text-[54px] font-normal leading-tight text-brand mb-4">Terms of Use</h1>
        <p class="text-base text-brand-muted">Effective as of March 10, 2026</p>
      </div>

      <div class="text-brand-dark text-[15px] leading-relaxed [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-brand [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:font-heading [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-brand [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-2 [&_a]:text-brand [&_a]:underline [&_a]:hover:text-black [&_hr]:my-8 [&_hr]:border-brand-border">

          <p>These Terms of Use ("Terms") govern your use of Verso AI ("Verso," "we," "us," or "our"), including our website, PowerPoint add-in, and web application (collectively, the "Service"). By using the Service, you agree to these Terms.</p>

