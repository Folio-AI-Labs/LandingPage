---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/languages';
import { WIDGET_URL } from '../../consts';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { locale: lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('playground.metaTitle')} description={t('playground.metaDescription')}>
  <Nav activePage={t('nav.playground')} />

  <section class="flex flex-col px-[30px] nav:px-[60px] pt-6 pb-10">
    <div class="text-center mb-5">
      <h1 class="font-display text-[32px] nav:text-[42px] font-normal leading-tight text-brand mb-2">{t('playground.title')}</h1>
      <p class="text-base nav:text-lg leading-relaxed text-brand-muted max-w-[640px] mx-auto">{t('playground.subtitle')}</p>
    </div>

    <div class="mx-auto w-full max-w-[1200px] rounded-2xl border-2 border-brand-border shadow-md overflow-hidden bg-white">
      <iframe
        src={WIDGET_URL}
        title={t('playground.title')}
        class="w-full h-[78vh] min-h-[560px] border-0 block"
        allow="clipboard-write; clipboard-read"
        loading="lazy"
      ></iframe>
    </div>

    <div class="text-center mt-4">
      <a
        href={WIDGET_URL}
        target="_blank"
        rel="noopener"
        class="font-heading text-sm text-brand-muted no-underline transition-colors duration-300 hover:text-brand"
      >
        {t('playground.openNewTab')} &rarr;
      </a>
    </div>
  </section>
</Layout>
