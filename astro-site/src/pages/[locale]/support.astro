---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/languages';
import { SUPPORT_FORM_URL } from '../../consts';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { locale: lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('support.metaTitle')} description={t('support.metaDescription')}>
  <Nav activePage="Support" />

  <main class="min-h-screen px-[30px] nav:px-[60px] py-20">
    <div class="max-w-[1200px] mx-auto w-full">
      <div class="text-center mb-12">
        <h1 class="font-display text-[42px] nav:text-[54px] font-normal leading-tight text-brand mb-4">{t('support.title')}</h1>
      </div>

      <!-- FAQ Section -->
      <div class="mb-16">
        <h2 class="font-display text-[28px] nav:text-[36px] font-normal text-brand mb-8 text-center">{t('support.faqTitle')}</h2>

        <div class="grid grid-cols-1 nav:grid-cols-2 gap-6">
          <!-- Getting Started -->
          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq1.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq1.a')}</p>
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq2.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq2.a')}</p>
            </div>
          </details>

          <!-- Technical Questions -->
          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq3.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq3.a')}</p>
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq4.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq4.a')}</p>
            </div>
          </details>

          <!-- Pricing & Plans -->
          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq5.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq5.a')}</p>
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq6.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq6.a')}</p>
            </div>
          </details>

          <!-- Privacy & Security -->
          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq7.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq7.a')}</p>
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq8.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq8.a')}</p>
            </div>
          </details>

          <!-- Enterprise & Team -->
          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq9.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq9.a')}</p>
            </div>
          </details>

          <!-- Troubleshooting -->
          <details class="group bg-white rounded-xl border border-brand-border overflow-hidden transition hover:border-brand h-fit">
            <summary class="cursor-pointer px-6 py-4 font-semibold text-brand flex items-center justify-between list-none">
              <span>{t('support.faq10.q')}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180 flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-brand-muted text-sm">
              <p>{t('support.faq10.a')}</p>
            </div>
          </details>
        </div>

        <div class="mt-8 text-center">
          <p class="text-brand-muted text-sm">{t('support.faqFooter')}</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="mt-16 max-w-[640px] mx-auto">
        <h2 class="font-display text-[28px] nav:text-[36px] font-normal text-brand mb-8 text-center">{t('support.contactTitle')}</h2>

      <form id="supportForm" data-action={SUPPORT_FORM_URL} class="space-y-6">

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-brand mb-2">{t('support.form.name')}</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-brand mb-2">{t('support.form.email')}</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-sm font-semibold text-brand mb-2">{t('support.form.subject')}</label>
          <input type="text" id="subject" name="subject" required class="w-full px-4 py-3 rounded-pill border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm" />
        </div>

        <div>
          <label for="message" class="block text-sm font-semibold text-brand mb-2">{t('support.form.message')}</label>
          <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-xl border border-brand-border focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none transition text-sm resize-y"></textarea>
        </div>

        <button type="submit" class="w-full bg-brand text-white px-7 py-3.5 rounded-pill font-medium text-base transition hover:-translate-y-0.5 hover:shadow-lg">
          {t('support.form.submit')}
        </button>
      </form>

      <div id="success-msg" class="hidden mt-8 p-6 bg-brand/5 rounded-xl text-center">
        <div class="text-brand font-bold text-lg mb-1">{t('support.form.successTitle')}</div>
        <p class="text-brand-muted text-sm">{t('support.form.successMessage')}</p>
      </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const supportForm = document.getElementById('supportForm') as HTMLFormElement;
  supportForm?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const url = supportForm.dataset.action!;
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const subject = (document.getElementById('subject') as HTMLInputElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value;
    const submitBtn = supportForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;

    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ name, email, subject, message }),
    });

    if (response.ok) {
      supportForm.style.display = 'none';
      (document.getElementById('success-msg') as HTMLElement).classList.remove('hidden');
    } else {
      submitBtn.disabled = false;
      alert('Something went wrong. Please try again or email us at contact@get-folio.ai.');
    }
  });

  // FAQ accordion — close other items when one is opened
  const faqItems = document.querySelectorAll('details');
  faqItems.forEach(item => {
    item.addEventListener('toggle', () => {
      if (item.open) {
        faqItems.forEach(other => {
          if (other !== item && other.open) {
            other.open = false;
          }
        });
      }
    });
  });
</script>
