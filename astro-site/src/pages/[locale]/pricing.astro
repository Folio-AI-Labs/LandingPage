---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/languages';
import { PLAYGROUND_URL } from '../../consts';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { locale: lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('pricing.metaTitle')} description={t('pricing.metaDescription')}>
  <Nav activePage={t('nav.pricing')} />

  <!-- Pricing Section -->
  <section class="min-h-screen pt-[80px] px-[30px] pb-[40px] nav:pt-[80px] nav:pb-[40px] nav:px-[60px]">
    <div class="text-center mb-8">
      <h1 class="font-display text-[42px] nav:text-[64px] font-normal leading-tight text-brand mb-6">{t('pricing.title')}</h1>
      <p class="font-display text-[18px] nav:text-[20px] leading-relaxed text-brand-dark max-w-[600px] mx-auto">{t('pricing.subtitle')}<br />{t('pricing.subtitle2')}</p>
    </div>

    <!-- Billing Toggle -->
    <div class="flex justify-center mb-10">
      <div class="relative inline-flex bg-white border-2 border-brand-border rounded-pill p-1 gap-1">
        <div id="toggleIndicator" class="absolute inset-y-1 bg-brand rounded-pill transition-all duration-200 pointer-events-none"></div>
        <button class="relative z-10 py-3 px-8 border-none bg-transparent text-white text-sm font-semibold cursor-pointer rounded-pill transition-colors duration-300 font-body" id="annualBtn">{t('pricing.annual')}</button>
        <button class="relative z-10 py-3 px-8 border-none bg-transparent text-brand-muted text-sm font-semibold cursor-pointer rounded-pill transition-colors duration-300 font-body" id="monthlyBtn">{t('pricing.monthly')}</button>
      </div>
    </div>

    <!-- Pricing Cards -->
    <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Starter Plan -->
      <div class="bg-white rounded-2xl px-6 py-7 border-2 border-brand-border transition duration-300 flex flex-col hover:-translate-y-2 hover:shadow-xl hover:border-brand">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[32px] font-semibold text-brand">{t('pricing.starter.name')}</h3>
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.starter.description')}</p>
        </div>

        <div class="mb-6 min-h-[80px]">
          <div class="flex items-baseline gap-2">
            <span class="text-[48px] font-bold text-brand font-display">$0</span>
            <span class="text-base text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl p-4 mb-6">
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.starter.credits')}</span> {t('pricing.starter.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.starter.creditPrice')}</span> {t('pricing.starter.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-8 flex-grow">
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature1')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature2')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature3')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.starter.feature4')}</li>
        </ul>

        <a href={PLAYGROUND_URL} class="block w-full py-4 rounded-pill text-center no-underline text-sm font-semibold transition duration-300 cursor-pointer border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white">{t('pricing.getStarted')}</a>
      </div>

      <!-- Plus Plan -->
      <div class="bg-white rounded-2xl px-6 py-7 border-2 border-brand-border transition duration-300 flex flex-col hover:-translate-y-2 hover:shadow-xl hover:border-brand">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[32px] font-semibold text-brand">{t('pricing.plus.name')}</h3>
            <img src="/hawk.svg" alt="Plus" class="w-[50px] h-[50px]" />
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.plus.description')}</p>
        </div>

        <div class="mb-6 min-h-[80px]">
          <div class="flex items-baseline gap-2 annual-price">
            <span class="text-[36px] font-bold text-brand-light line-through font-display">$19</span>
            <span class="text-[48px] font-bold text-brand font-display">$15</span>
            <span class="text-base text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
          <div class="items-baseline gap-2 monthly-price hidden">
            <span class="text-[48px] font-bold text-brand font-display">$19</span>
            <span class="text-base text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl p-4 mb-6">
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.plus.credits')}</span> {t('pricing.plus.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.plus.creditPrice')}</span> {t('pricing.plus.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-8 flex-grow">
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span><strong>{t('pricing.plus.feature1')}</strong></li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.plus.feature2')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.plus.feature3')}</li>
        </ul>

        <a href={PLAYGROUND_URL} class="block w-full py-4 rounded-pill text-center no-underline text-sm font-semibold transition duration-300 cursor-pointer border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white">{t('pricing.getStarted')}</a>
      </div>

      <!-- Pro Plan -->
      <div class="bg-white rounded-2xl px-6 py-7 border-2 border-brand transition duration-300 flex flex-col relative hover:-translate-y-2 hover:shadow-xl">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand text-white py-1.5 px-4 rounded-[20px] text-[10px] font-bold tracking-[0.5px] uppercase whitespace-nowrap">{t('pricing.mostPopular')}</span>
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[32px] font-semibold text-brand">{t('pricing.pro.name')}</h3>
            <img src="/eagle.svg" alt="Pro" class="w-[50px] h-[50px]" />
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.pro.description')}</p>
        </div>

        <div class="mb-6 min-h-[80px]">
          <div class="flex items-baseline gap-2 annual-price">
            <span class="text-[36px] font-bold text-brand-light line-through font-display">$49</span>
            <span class="text-[48px] font-bold text-brand font-display">$37</span>
            <span class="text-base text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
          <div class="items-baseline gap-2 monthly-price hidden">
            <span class="text-[48px] font-bold text-brand font-display">$49</span>
            <span class="text-base text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl p-4 mb-6">
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.pro.credits')}</span> {t('pricing.pro.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.pro.creditPrice')}</span> {t('pricing.pro.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-8 flex-grow">
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span><strong>{t('pricing.pro.feature1')}</strong></li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.pro.feature2')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.pro.feature3')}</li>
        </ul>

        <a href={PLAYGROUND_URL} class="block w-full py-4 rounded-pill text-center no-underline text-sm font-semibold transition duration-300 cursor-pointer border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white">{t('pricing.getStarted')}</a>
      </div>

      <!-- Ultimate Plan -->
      <div class="bg-white rounded-2xl px-6 py-7 border-2 border-brand-border transition duration-300 flex flex-col hover:-translate-y-2 hover:shadow-xl hover:border-brand">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[32px] font-semibold text-brand">{t('pricing.ultimate.name')}</h3>
            <img src="/raptor.svg" alt="Ultimate" class="w-[50px] h-[50px]" />
          </div>
          <p class="text-sm text-brand-muted leading-normal">{t('pricing.ultimate.description')}</p>
        </div>

        <div class="mb-6 min-h-[80px]">
          <div class="flex items-baseline gap-2 annual-price">
            <span class="text-[36px] font-bold text-brand-light line-through font-display">$99</span>
            <span class="text-[48px] font-bold text-brand font-display">$75</span>
            <span class="text-base text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
          <div class="items-baseline gap-2 monthly-price hidden">
            <span class="text-[48px] font-bold text-brand font-display">$99</span>
            <span class="text-base text-brand-muted">{t('pricing.perMonth')}</span>
          </div>
        </div>

        <div class="bg-brand-bg rounded-xl p-4 mb-6">
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.ultimate.credits')}</span> {t('pricing.ultimate.creditsDesc')}</p>
          <p class="text-sm leading-relaxed text-brand-dark"><span class="font-semibold text-brand">{t('pricing.ultimate.creditPrice')}</span> {t('pricing.ultimate.creditPriceDesc')}</p>
        </div>

        <ul class="list-none mb-8 flex-grow">
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span><strong>{t('pricing.ultimate.feature1')}</strong></li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.ultimate.feature2')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.ultimate.feature3')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.ultimate.feature4')}</li>
          <li class="flex items-start gap-3 mb-3 text-sm leading-relaxed text-brand-dark"><span class="text-brand font-bold text-base shrink-0">✓</span>{t('pricing.ultimate.feature5')}</li>
        </ul>

        <a href={PLAYGROUND_URL} class="block w-full py-4 rounded-pill text-center no-underline text-sm font-semibold transition duration-300 cursor-pointer border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white">{t('pricing.getStarted')}</a>
      </div>

    </div>

    <!-- FAQ Section -->
    <div class="max-w-[1200px] mx-auto mt-12">
      <h2 class="font-display text-[34px] font-semibold text-center mb-8 text-brand">{t('pricing.faq.title')}</h2>

      <div class="grid grid-cols-1 nav:grid-cols-2 gap-6 items-start">
        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q1')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a1')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q2')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a2')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q3')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a3')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q4')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a4')}</p>
            </div>
          </div>
        </details>

        <details class="group bg-white border-2 border-brand-border rounded-xl overflow-hidden transition duration-300 self-start hover:border-brand">
          <summary class="py-4 px-6 cursor-pointer font-semibold text-base text-brand list-none [&::-webkit-details-marker]:hidden flex justify-between items-center">
            {t('pricing.faq.q5')}
            <span class="text-2xl font-light transition-transform duration-300 group-[.expanded]:rotate-45">+</span>
          </summary>
          <div class="faq-content grid grid-rows-[0fr] group-[.expanded]:grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-in-out">
            <div class="overflow-hidden opacity-0 group-[.expanded]:opacity-100 transition-opacity duration-150">
              <p class="px-6 pb-4 text-brand-muted leading-[1.8]">{t('pricing.faq.a5')}</p>
            </div>
          </div>
        </details>
      </div>
    </div>

  </section>

  <CtaBanner />
  <Footer />
</Layout>

<script>
  // Billing toggle with sliding indicator
  const annualBtn = document.getElementById('annualBtn');
  const monthlyBtn = document.getElementById('monthlyBtn');
  const indicator = document.getElementById('toggleIndicator');
  const annualPrices = document.querySelectorAll('.annual-price');
  const monthlyPrices = document.querySelectorAll('.monthly-price');

  function moveIndicator(btn: HTMLElement) {
    if (indicator) {
      indicator.style.left = btn.offsetLeft + 'px';
      indicator.style.width = btn.offsetWidth + 'px';
    }
  }

  if (annualBtn) moveIndicator(annualBtn);

  annualBtn?.addEventListener('click', () => {
    moveIndicator(annualBtn);
    annualBtn.classList.add('text-white');
    annualBtn.classList.remove('text-brand-muted');
    monthlyBtn?.classList.add('text-brand-muted');
    monthlyBtn?.classList.remove('text-white');
    annualPrices.forEach(price => { price.classList.remove('hidden'); price.classList.add('flex'); });
    monthlyPrices.forEach(price => { price.classList.add('hidden'); price.classList.remove('flex'); });
  });

  monthlyBtn?.addEventListener('click', () => {
    if (monthlyBtn) moveIndicator(monthlyBtn);
    monthlyBtn?.classList.add('text-white');
    monthlyBtn?.classList.remove('text-brand-muted');
    annualBtn?.classList.add('text-brand-muted');
    annualBtn?.classList.remove('text-white');
    annualPrices.forEach(price => { price.classList.add('hidden'); price.classList.remove('flex'); });
    monthlyPrices.forEach(price => { price.classList.remove('hidden'); price.classList.add('flex'); });
  });

  // FAQ smooth open/close
  const faqItems = document.querySelectorAll('details');

  function closeFaq(item: HTMLDetailsElement) {
    item.classList.remove('expanded');
    item.querySelector('.faq-content')?.addEventListener('transitionend', () => {
      item.open = false;
    }, { once: true });
  }

  faqItems.forEach(item => {
    item.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();

      if (item.classList.contains('expanded')) {
        closeFaq(item as HTMLDetailsElement);
      } else {
        faqItems.forEach(other => {
          if (other !== item && other.classList.contains('expanded')) {
            closeFaq(other as HTMLDetailsElement);
          }
        });
        (item as HTMLDetailsElement).open = true;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            item.classList.add('expanded');
          });
        });
      }
    });
  });
</script>
