---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/languages';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter(lang => lang !== defaultLang)
    .map(lang => ({ params: { locale: lang } }));
}

const { locale } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const localeFormats: Record<string, string> = {
  fr: 'fr-FR',
  de: 'de-DE',
  es: 'es-ES',
};

const localizedLangs = new Set(['fr', 'es', 'de']);
const contentLang = localizedLangs.has(locale!) ? locale! : defaultLang;
const blogBase = contentLang === defaultLang ? '/blog' : `/${contentLang}/blog`;

const posts = (await getCollection('blog', ({ data }) => data.lang === contentLang)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title={t('blog.metaTitle')} description={t('blog.metaDescription')}>
  <Nav activePage={t('nav.articles')} />

  <section class="flex-1 max-w-4xl mx-auto pt-[120px] px-6 pb-20 w-full">
    <h1 class="font-heading text-3xl nav:text-4xl font-semibold text-brand mb-12">{t('blog.title')}</h1>

    <div class="grid gap-6">
      {posts.map((post) => {
        const slug = post.id.includes('/') ? post.id.split('/').slice(1).join('/') : post.id;
        return (
        <a href={`${blogBase}/${slug}/`} class="block no-underline group">
          <div class="border border-brand-border rounded-xl p-6 nav:p-8 transition duration-300 hover:border-brand/30 hover:shadow-md bg-white">
            <p class="text-sm text-brand-muted/60 mb-2 font-body">
              {post.data.date.toLocaleDateString(localeFormats[locale!] || 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="font-heading text-xl nav:text-2xl font-semibold text-brand mb-3 group-hover:text-brand/80 transition-colors duration-300">
              {post.data.title}
            </h2>
            <p class="text-brand-muted text-base leading-relaxed mb-0">
              {post.data.description}
            </p>
          </div>
        </a>
        );
      })}
    </div>
  </section>

  <Footer />
</Layout>
