              </tr>
              <tr>
                <td>{t('privacy.s7.sub3.table.r2c1')}</td>
                <td>{t('privacy.s7.sub3.table.r2c2')}</td>
              </tr>
              <tr>
                <td>{t('privacy.s7.sub3.table.r3c1')}</td>
                <td>{t('privacy.s7.sub3.table.r3c2')}</td>
              </tr>
              <tr>
                <td>{t('privacy.s7.sub3.table.r4c1')}</td>
