---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { languages, defaultLang } from '../../i18n/languages';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { locale: lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('privacy.meta.title')} description={t('privacy.meta.description')}>
  <Nav />

  <main class="px-[30px] nav:px-[60px] py-20">
    <div class="max-w-[800px] mx-auto">

      <div class="text-center mb-12">
        <h1 class="font-display text-[42px] nav:text-[54px] font-normal leading-tight text-brand mb-4">{t('privacy.title')}</h1>
        <p class="text-base text-brand-muted">{t('privacy.effectiveDate')}</p>
      </div>

      <div class="text-brand-dark text-[15px] leading-relaxed [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-brand [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:font-heading [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-brand [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_li]:mb-2 [&_a]:text-brand [&_a]:underline [&_a]:hover:text-black [&_table]:w-full [&_table]:text-sm [&_table]:my-6 [&_table]:border-collapse [&_th]:text-left [&_th]:font-semibold [&_th]:text-brand [&_th]:py-2 [&_th]:px-3 [&_th]:border-b [&_th]:border-brand-border [&_td]:py-2 [&_td]:px-3 [&_td]:border-b [&_td]:border-brand-border [&_hr]:my-8 [&_hr]:border-brand-border">

          <p set:html={t('privacy.intro.p1')} />
          <p set:html={t('privacy.intro.p2')} />

          <h2>{t('privacy.s1.title')}</h2>
          <h3>{t('privacy.s1.sub1.title')}</h3>
          <ul>
            <li set:html={t('privacy.s1.sub1.li1')} />
            <li set:html={t('privacy.s1.sub1.li2')} />
            <li set:html={t('privacy.s1.sub1.li3')} />
            <li set:html={t('privacy.s1.sub1.li4')} />
          </ul>

          <h3>{t('privacy.s1.sub2.title')}</h3>
          <ul>
            <li set:html={t('privacy.s1.sub2.li1')} />
            <li set:html={t('privacy.s1.sub2.li2')} />
          </ul>

          <h3>{t('privacy.s1.sub3.title')}</h3>
          <ul>
            <li set:html={t('privacy.s1.sub3.li1')} />
            <li set:html={t('privacy.s1.sub3.li2')} />
            <li set:html={t('privacy.s1.sub3.li3')} />
          </ul>

          <h2>{t('privacy.s2.title')}</h2>
          <ul>
            <li set:html={t('privacy.s2.li1')} />
            <li set:html={t('privacy.s2.li2')} />
            <li set:html={t('privacy.s2.li3')} />
            <li set:html={t('privacy.s2.li4')} />
            <li set:html={t('privacy.s2.li5')} />
            <li set:html={t('privacy.s2.li6')} />
          </ul>

          <h2>{t('privacy.s3.title')}</h2>
          <p set:html={t('privacy.s3.p1')} />
          <ul>
            <li set:html={t('privacy.s3.li1')} />
            <li set:html={t('privacy.s3.li2')} />
          </ul>
          <p set:html={t('privacy.s3.p2')} />
          <p set:html={t('privacy.s3.p3')} />

          <h2>{t('privacy.s4.title')}</h2>
          <p set:html={t('privacy.s4.p1')} />
          <table>
            <thead>
              <tr>
                <th>{t('privacy.s4.table.th1')}</th>
                <th>{t('privacy.s4.table.th2')}</th>
                <th>{t('privacy.s4.table.th3')}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>{t('privacy.s4.table.r1c1')}</td>
                <td>{t('privacy.s4.table.r1c2')}</td>
                <td>{t('privacy.s4.table.r1c3')}</td>
              </tr>
              <tr>
                <td>{t('privacy.s4.table.r2c1')}</td>
                <td>{t('privacy.s4.table.r2c2')}</td>
