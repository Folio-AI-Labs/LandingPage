              </tr>
              <tr>
                <td>{t('privacy.s7.sub3.table.r5c1')}</td>
                <td>{t('privacy.s7.sub3.table.r5c2')}</td>
              </tr>
              <tr>
                <td>{t('privacy.s7.sub3.table.r6c1')}</td>
                <td>{t('privacy.s7.sub3.table.r6c2')}</td>
              </tr>
            </tbody>
          </table>

          <h2>{t('privacy.s8.title')}</h2>
          <p set:html={t('privacy.s8.p1')} />

          <h2>{t('privacy.s9.title')}</h2>
          <p set:html={t('privacy.s9.p1')} />
          <p set:html={t('privacy.s9.p2')} />

          <h2>{t('privacy.s10.title')}</h2>
          <p set:html={t('privacy.s10.p1')} />

          <h2>{t('privacy.s11.title')}</h2>
          <p set:html={t('privacy.s11.p1')} />

          <h2>{t('privacy.s12.title')}</h2>
          <p set:html={t('privacy.s12.p1')} />

          <h2>{t('privacy.s13.title')}</h2>
          <p set:html={t('privacy.s13.p1')} />
          <ul>
            <li set:html={t('privacy.s13.email')} />
          </ul>

          <hr />
          <p class="text-sm text-slate-500 italic" set:html={t('privacy.disclaimer')} />

      </div>
    </div>
  </main>

  <Footer />
</Layout>
