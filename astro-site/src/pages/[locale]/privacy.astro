            <li set:html={t('privacy.s5.li4')} />
          </ul>
          <p set:html={t('privacy.s5.p1')} />

          <h2>{t('privacy.s6.title')}</h2>
          <ul>
            <li set:html={t('privacy.s6.li1')} />
            <li set:html={t('privacy.s6.li2')} />
            <li set:html={t('privacy.s6.li3')} />
            <li set:html={t('privacy.s6.li4')} />
          </ul>
          <p set:html={t('privacy.s6.p1')} />

          <h2>{t('privacy.s7.title')}</h2>
          <h3>{t('privacy.s7.sub1.title')}</h3>
