---
import LanguageSelector from './LanguageSelector.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { href: getLocalizedPath('/', lang), label: t('nav.home') },
  { href: getLocalizedPath('/#features', lang), label: t('nav.features') },
  { href: getLocalizedPath('/#models', lang), label: t('nav.models') },
  { href: getLocalizedPath('/pricing/', lang), label: t('nav.pricing') },
  { href: getLocalizedPath('/blog/', lang), label: t('nav.articles') },
  { href: getLocalizedPath('/help/', lang), label: t('nav.help') },
];
---

<nav class="sticky top-0 nav:relative z-[1002] grid grid-cols-[auto_1fr] nav:grid-cols-[auto_1fr_auto] items-center gap-6 py-4 px-6 nav:px-[60px] bg-white/80 border-b border-black/5 backdrop-blur-sm font-heading overflow-visible">
  <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2 text-[17px] font-semibold text-brand no-underline transition-colors duration-300 hover:text-black">
    <img src="/folio_logo_small.png" alt="Folio AI Logo" class="w-[33px] h-[33px]" />
    <span class="font-heading">Folio AI</span>
  </a>
  <ul class="hidden nav:flex gap-[42px] list-none justify-center m-0 p-0">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class:list={[
            'no-underline text-[15px] font-medium transition-colors duration-300 hover:text-brand',
            activePage === link.label ? 'text-brand' : 'text-brand-muted',
          ]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="hidden nav:flex items-center gap-4 justify-end">
    <LanguageSelector />
    <button data-open-install-modal class="bg-brand text-white border-none py-2.5 px-4 text-sm font-medium cursor-pointer rounded-pill transition duration-300 hover:-translate-y-px hover:shadow-md font-body">{t('nav.getStarted')}</button>
  </div>
  <button class="burger-menu group flex nav:hidden flex-col justify-center items-center bg-transparent border-none cursor-pointer p-2.5 z-[1001] w-10 h-10 relative justify-self-end" aria-label="Toggle menu">
    <span class="block w-[25px] h-[3px] bg-brand rounded-[3px] transition-all duration-300 ease-in-out absolute top-[10px] group-[.active]:top-[18.5px] group-[.active]:rotate-45"></span>
    <span class="block w-[25px] h-[3px] bg-brand rounded-[3px] transition-all duration-300 ease-in-out absolute top-[18.5px] group-[.active]:-rotate-45"></span>
    <span class="block w-[25px] h-[3px] bg-brand rounded-[3px] transition-all duration-300 ease-in-out absolute top-[27px] group-[.active]:opacity-0"></span>
  </button>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu block nav:hidden fixed top-[72px] left-0 right-0 bg-white/95 px-6 z-[1000] max-h-0 overflow-hidden transition duration-300 backdrop-blur-sm [&.active]:max-h-[500px] [&.active]:py-5">
  <ul class="list-none flex flex-col gap-4">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class:list={[
            'no-underline text-base font-medium font-heading transition-colors duration-300 block py-2 hover:text-brand',
            activePage === link.label ? 'text-brand' : 'text-brand-muted',
          ]}
        >
          {link.label}
        </a>
      </li>
    ))}
    <li class="flex justify-center pt-2">
      <LanguageSelector />
    </li>
    <li><button data-open-install-modal class="bg-brand text-white border-none py-3 px-5 text-sm font-medium rounded-pill text-center transition duration-300 block w-full cursor-pointer hover:-translate-y-px hover:shadow-md">{t('nav.getStarted')}</button></li>
  </ul>
</div>

<script>
  const burgerMenu = document.querySelector('.burger-menu');
  const mobileMenu = document.querySelector('.mobile-menu');

  burgerMenu?.addEventListener('click', () => {
    burgerMenu.classList.toggle('active');
    mobileMenu?.classList.toggle('active');
  });

  document.querySelectorAll('.mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      burgerMenu?.classList.remove('active');
      mobileMenu?.classList.remove('active');
    });
  });

  document.addEventListener('click', (e) => {
    if (burgerMenu && mobileMenu && !burgerMenu.contains(e.target as Node) && !mobileMenu.contains(e.target as Node)) {
      burgerMenu.classList.remove('active');
      mobileMenu.classList.remove('active');
    }
  });
</script>
