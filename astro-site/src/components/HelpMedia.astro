---
interface Props {
  /** Short description of what the screenshot or video should show. */
  caption: string;
  /** Visual type — affects the icon and label. */
  type?: 'image' | 'video';
  /** When set, renders the actual asset instead of a placeholder. */
  src?: string;
  /** Optional alt text for the image; falls back to the caption. */
  alt?: string;
}

const { caption, type = 'image', src, alt } = Astro.props;
---

<figure class="my-8">
  {src && type === 'video' ? (
    <video
      src={src}
      controls
      preload="metadata"
      class="w-full rounded-xl border border-brand-border shadow-sm"
    >
      <track kind="captions" />
    </video>
  ) : src ? (
    <img
      src={src}
      alt={alt ?? caption}
      loading="lazy"
      decoding="async"
      class="w-full rounded-xl border border-brand-border shadow-sm"
    />
  ) : (
    <div class="flex flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-brand-border bg-brand-bg py-14 px-6 text-center">
      {type === 'video' ? (
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-light"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m10 8 6 4-6 4Z"/></svg>
      ) : (
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-light"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
      )}
      <p class="font-heading text-sm font-semibold uppercase tracking-wide text-brand-light m-0">
        {type === 'video' ? 'Video placeholder' : 'Screenshot placeholder'}
      </p>
    </div>
  )}
  <figcaption class="mt-2 text-center font-body text-sm text-brand-light">{caption}</figcaption>
</figure>
