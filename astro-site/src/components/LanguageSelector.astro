---
import { getLangFromUrl, getCurrentPath } from '../i18n/utils';
import { languages as languageMap } from '../i18n/languages';

const lang = getLangFromUrl(Astro.url);
const currentPath = getCurrentPath(Astro.url);

const languages = [
  { code: 'en', label: 'English', display: 'EN' },
  { code: 'fr', label: 'Français', display: 'FR' },
  { code: 'es', label: 'Español', display: 'ES' },
  { code: 'de', label: 'Deutsch', display: 'DE' },
];

const currentLanguage = languages.find(l => l.code === lang)?.display || 'EN';
---

<div class="language-selector relative static">
  <button
    class="language-button font-heading text-sm font-medium text-brand-muted hover:text-brand transition-colors duration-300 cursor-pointer bg-transparent border-none flex items-center gap-1.5"
    aria-label="Select language"
  >
    <span class="language-current">{currentLanguage}</span>
    <svg class="chevron w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div class="language-dropdown fixed mt-2 bg-white border border-brand-border rounded-lg shadow-lg py-1 w-auto opacity-0 invisible pointer-events-none transition-all duration-200 z-[1003]">
    {languages.map(l => {
      const href = l.code === 'en' ? currentPath : `/${l.code}${currentPath}`;
      return (
        <a
          href={href}
          class="language-option font-heading text-sm font-medium text-brand-muted hover:text-brand hover:bg-brand-bg w-full text-left pl-3 pr-6 py-1.5 transition-colors duration-200 cursor-pointer bg-transparent border-none block no-underline"
          data-lang={l.display}
          aria-label={`Switch to ${l.label}`}
        >
          {l.display}
        </a>
      );
    })}
  </div>
</div>

<style>
  .language-selector:hover .language-dropdown,
  .language-selector:focus-within .language-dropdown,
  .language-dropdown:hover,
  .language-dropdown.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .language-selector:hover .chevron,
  .language-selector:focus-within .chevron,
  .language-dropdown:hover ~ .language-button .chevron,
  .language-dropdown.show ~ .language-button .chevron {
    transform: rotate(180deg);
  }

  .language-option.active {
    color: var(--brand);
    font-weight: 600;
  }
</style>

<script>
  const languageSelector = document.querySelector('.language-selector');
  const languageButton = document.querySelector('.language-button');
  const languageDropdown = document.querySelector('.language-dropdown');
  const languageOptions = document.querySelectorAll('.language-option');
  const currentLanguageDisplay = document.querySelector('.language-current');

  let hideTimeout: number | null = null;

  // Position dropdown function
  function positionDropdown() {
    if (languageButton && languageDropdown) {
      const rect = languageButton.getBoundingClientRect();
      const minRightMargin = 1.25; // Narrow space from right edge (50% of 2.5px)
      const windowWidth = window.innerWidth;

      // Position dropdown aligned to the right with margin
      const rightPosition = windowWidth - rect.right;

      (languageDropdown as HTMLElement).style.top = `${rect.bottom + 8}px`;
      (languageDropdown as HTMLElement).style.right = `${rightPosition + minRightMargin}px`;
      (languageDropdown as HTMLElement).style.left = 'auto';
    }
  }

  // Show dropdown
  function showDropdown() {
    if (hideTimeout) {
      clearTimeout(hideTimeout);
      hideTimeout = null;
    }
    positionDropdown();
    languageDropdown?.classList.add('show');
  }

  // Hide dropdown with delay
  function hideDropdown() {
    hideTimeout = window.setTimeout(() => {
      languageDropdown?.classList.remove('show');
    }, 150);
  }

  // Position on hover/focus
  languageSelector?.addEventListener('mouseenter', showDropdown);
  languageSelector?.addEventListener('mouseleave', hideDropdown);
  languageSelector?.addEventListener('focusin', showDropdown);

  // Keep dropdown visible when hovering over it
  languageDropdown?.addEventListener('mouseenter', showDropdown);
  languageDropdown?.addEventListener('mouseleave', hideDropdown);

  // Reposition on scroll and resize
  window.addEventListener('scroll', positionDropdown);
  window.addEventListener('resize', positionDropdown);

  // Language links will handle navigation automatically, no click handler needed

  // Set initial active state
  const currentLang = currentLanguageDisplay?.textContent?.trim();
  languageOptions.forEach(option => {
    if (option.getAttribute('data-lang') === currentLang) {
      option.classList.add('active');
    }
  });
</script>
