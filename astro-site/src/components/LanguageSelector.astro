---
import { getLangFromUrl, getCurrentPath } from '../i18n/utils';
import { languages as languageMap } from '../i18n/languages';

const lang = getLangFromUrl(Astro.url);
const currentPath = getCurrentPath(Astro.url);

// Pages that have a localized ([locale]/) build. Anything outside this set is
// English-only (e.g. /terms/, standalone deck pages), so switching language must
// go to that locale's home instead of fabricating a URL that 404s.
const localizedRoute = [
  /^\/$/,
  /^\/(pricing|demo|privacy|quote|support|blog)\/$/,
  /^\/blog\/[^/]+\/$/,
  /^\/help(\/[^/]+)?\/$/,
].some((re) => re.test(currentPath));

const languages = [
  { code: 'en', label: 'English', display: 'EN' },
  { code: 'fr', label: 'Français', display: 'FR' },
  { code: 'es', label: 'Español', display: 'ES' },
  { code: 'de', label: 'Deutsch', display: 'DE' },
];

const currentLanguage = languages.find(l => l.code === lang)?.display || 'EN';
---

<details class="language-selector relative">
  <summary
    class="language-button font-heading text-sm font-medium text-brand-muted hover:text-brand transition-colors duration-300 cursor-pointer bg-transparent border-none flex items-center gap-1.5 list-none [&::-webkit-details-marker]:hidden"
    aria-label="Select language"
  >
    <span class="language-current">{currentLanguage}</span>
    <svg class="chevron w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </summary>

  <div class="language-dropdown absolute right-0 top-full mt-2 bg-white border border-brand-border rounded-lg shadow-lg py-1 w-auto z-[1003]">
    {languages.map(l => {
      const href = l.code === 'en'
        ? currentPath
        : localizedRoute ? `/${l.code}${currentPath}` : `/${l.code}/`;
      const isActive = l.display === currentLanguage;
      return (
        <a
          href={href}
          class:list={[
            'language-option font-heading text-sm font-medium hover:text-brand hover:bg-brand-bg w-full text-left pl-3 pr-6 py-1.5 transition-colors duration-200 cursor-pointer bg-transparent border-none block no-underline',
            isActive ? 'text-brand font-semibold' : 'text-brand-muted',
          ]}
          aria-label={`Switch to ${l.label}`}
        >
          {l.display}
        </a>
      );
    })}
  </div>
</details>

<style>
  .language-selector[open] .chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  // Close when clicking outside
  document.addEventListener('click', (e) => {
    const selector = document.querySelector('.language-selector');
    if (selector && !selector.contains(e.target as Node)) {
      selector.removeAttribute('open');
    }
  });
</script>
