---
import { DESKTOP_INSTALL_URL, WEB_INSTALL_URL } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div id="install-modal" class="fixed inset-0 z-[2000] hidden items-center justify-center">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-close-modal></div>
  <div class="relative bg-white rounded-2xl shadow-2xl p-8 max-w-[420px] w-[90%] text-center z-10">
    <button data-close-modal class="absolute top-4 right-4 text-brand-muted hover:text-brand transition-colors bg-transparent border-none cursor-pointer text-xl leading-none p-1" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    <h3 class="font-heading text-xl font-semibold text-brand mb-6">{t('install.title')}</h3>

    <a
      href={DESKTOP_INSTALL_URL}
      class="flex items-center justify-center gap-3 w-full bg-brand text-white py-4 px-6 rounded-xl no-underline text-base font-semibold transition duration-300 hover:-translate-y-0.5 hover:shadow-lg mb-4"
      data-install-choice="desktop"
    >
      <img src="/powerpoint-logo.png" alt="PowerPoint" class="h-8 w-auto" />
      <span>{t('install.powerpoint')}</span>
    </a>

    {/* Google Slides add-on "coming soon" badge commented out until the Marketplace listing is approved
        (Google OAuth review: no Marketplace links/CTAs or "coming soon" texts on the site until live).
    <div class="relative mb-4">
      <span
        aria-disabled="true"
        class="flex items-center justify-center gap-3 w-full bg-brand/60 text-white py-4 px-6 rounded-xl text-base font-semibold cursor-not-allowed select-none"
      >
        <img src="/google-slides-logo.png" alt="Google Slides" class="h-8 w-auto opacity-90" />
        <span>{t('install.googleSlides')}</span>
      </span>
      <span class="pointer-events-none absolute -top-2 right-3 rounded-full bg-white text-brand text-[11px] font-semibold px-2 py-0.5 shadow-sm border border-brand-border whitespace-nowrap">{t('help.comingSoon')}</span>
    </div>
    */}

    <a
      href={WEB_INSTALL_URL}
      target="_blank"
      rel="noopener"
      class="inline-block text-sm text-brand-muted hover:text-brand transition-colors no-underline underline-offset-2 hover:underline"
      data-install-choice="web"
    >
      {t('install.fallback')}
    </a>
  </div>
</div>

<script>
  const modal = document.getElementById('install-modal');

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  document.querySelectorAll('[data-open-install-modal]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });

  modal?.querySelectorAll('[data-close-modal]').forEach(el => {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
