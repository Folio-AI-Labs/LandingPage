---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locales = {
  en: 'en-US',
  fr: 'fr-FR',
  es: 'es-ES',
  de: 'de-DE',
} as const;
const evaluationDateValue = new Date();
const evaluationDate = new Intl.DateTimeFormat(locales[lang], {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(evaluationDateValue);
const evaluationDateIso = evaluationDateValue.toISOString().slice(0, 10);
---

<div class="w-full max-w-[600px] mx-auto">
  <svg viewBox="-10 0 510 340" class="w-full" xmlns="http://www.w3.org/2000/svg">
    <!-- Y axis (extended ±0.75 at ends to align stroke edges with perpendicular lines) -->
    <line x1="40" y1="280.75" x2="40" y2="39.25" stroke="#666666" stroke-width="1.5"/>

    <!-- 100% tick and label (extended right by 0.75 to align with Y axis right edge) -->
    <line x1="30" y1="40" x2="40.75" y2="40" stroke="#666666" stroke-width="1.5"/>
    <text x="26" y="44" text-anchor="end" font-family="Inter, sans-serif" font-size="11" fill="#999999">100%</text>

    <!-- Bars: baseline=280, chart height=240 (100% = y:40). 5 bars, width 70, step 86 from x=52 -->
    <!-- Flat bottom via clipPath, rounded top via rect with rx/ry -->
    <defs>
      <clipPath id="clip-bottom">
        <rect x="0" y="0" width="500" height="280"/>
      </clipPath>
      <pattern id="folio-max-fill" patternUnits="userSpaceOnUse" x="52" y="112" width="70" height="174">
        <image href="/bar_texture_medium.webp" x="0" y="0" width="70" height="174" preserveAspectRatio="xMidYMid slice"/>
      </pattern>
      <pattern id="folio-medium-fill" patternUnits="userSpaceOnUse" x="138" y="119.2" width="70" height="166.8">
        <image href="/bar_texture_medium.webp" x="0" y="0" width="70" height="166.8" preserveAspectRatio="xMidYMid slice"/>
      </pattern>
      <pattern id="folio-fast-fill" patternUnits="userSpaceOnUse" x="224" y="176.8" width="70" height="109.2">
        <image href="/bar_texture_fast.webp" x="0" y="0" width="70" height="109.2" preserveAspectRatio="xMidYMid slice"/>
      </pattern>
    </defs>

    <!-- Folio Max: 70% => height=168, y=112 -->
    <rect x="52" y="112" width="70" height="174" rx="6" ry="6" fill="url(#folio-max-fill)" clip-path="url(#clip-bottom)"/>
    <text x="87" y="102" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#1a1a1a">70%</text>
    <text x="87" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#1a1a1a">
      <tspan x="87" dy="0">Folio</tspan>
      <tspan x="87" dy="15">Max</tspan>
    </text>

    <!-- Folio Medium: 67% => height=160.8, y=119.2 -->
    <rect x="138" y="119.2" width="70" height="166.8" rx="6" ry="6" fill="url(#folio-medium-fill)" clip-path="url(#clip-bottom)"/>
    <text x="173" y="109.2" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#1a1a1a">67%</text>
    <text x="173" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#1a1a1a">
      <tspan x="173" dy="0">Folio</tspan>
      <tspan x="173" dy="15">Medium</tspan>
    </text>

    <!-- Folio Fast: 43% => height=103.2, y=176.8 -->
    <rect x="224" y="176.8" width="70" height="109.2" rx="6" ry="6" fill="url(#folio-fast-fill)" clip-path="url(#clip-bottom)"/>
    <text x="259" y="166.8" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#1a1a1a">43%</text>
    <text x="259" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#1a1a1a">
      <tspan x="259" dy="0">Folio</tspan>
      <tspan x="259" dy="15">Fast</tspan>
    </text>

    <!-- Claude for PowerPoint: 47% => height=112.8, y=167.2 -->
    <rect x="310" y="167.2" width="70" height="118.8" rx="6" ry="6" fill="#c8c8c8" clip-path="url(#clip-bottom)"/>
    <text x="345" y="157.2" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#999999">47%</text>
    <text x="345" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#999999">
      <tspan x="345" dy="0">Claude for</tspan>
      <tspan x="345" dy="15">PowerPoint</tspan>
    </text>

    <!-- GenSpark: 16% => height=38.4, y=241.6 -->
    <rect x="396" y="241.6" width="70" height="44.4" rx="6" ry="6" fill="#c8c8c8" clip-path="url(#clip-bottom)"/>
    <text x="431" y="231.6" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#999999">16%</text>
    <text x="431" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#999999">
      <tspan x="431" dy="0">GenSpark</tspan>
      <tspan x="431" dy="15">&nbsp;</tspan>
    </text>

    <!-- X axis (drawn after bars so it renders on top; extended left by 0.75 to align with Y axis left edge) -->
    <line x1="39.25" y1="280" x2="480" y2="280" stroke="#666666" stroke-width="1.5"/>
  </svg>
  <p class="mt-5 text-center text-sm text-brand-muted">
    {t('models.evaluation')} · <time dateTime={evaluationDateIso}>{evaluationDate}</time>
  </p>
</div>
