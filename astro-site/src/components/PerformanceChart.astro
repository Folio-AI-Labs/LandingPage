<div class="w-full max-w-[600px] mx-auto">
  <svg viewBox="0 0 500 340" class="w-full" xmlns="http://www.w3.org/2000/svg">
    <!-- Y axis -->
    <line x1="40" y1="280" x2="40" y2="20" stroke="#666666" stroke-width="1.5"/>

    <!-- 100% tick and label -->
    <line x1="30" y1="40" x2="40" y2="40" stroke="#666666" stroke-width="1.5"/>
    <text x="26" y="44" text-anchor="end" font-family="Inter, sans-serif" font-size="11" fill="#999999">100%</text>

    <!-- X axis (no arrowhead) -->
    <line x1="40" y1="280" x2="480" y2="280" stroke="#666666" stroke-width="1.5"/>

    <!-- Bars: baseline=280, chart height=240 (100% = y:40) -->
    <!-- Flat bottom via clipPath, rounded top via rect with rx/ry -->
    <defs>
      <clipPath id="clip-bottom">
        <rect x="0" y="0" width="500" height="280"/>
      </clipPath>
    </defs>

    <!-- Verso AI Pro: 65% => height=156, y=124 -->
    <rect x="65" y="124" width="70" height="162" rx="6" ry="6" fill="#1a1a1a" clip-path="url(#clip-bottom)"/>
    <text x="100" y="114" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#1a1a1a">65%</text>
    <text x="100" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#1a1a1a">
      <tspan x="100" dy="0">Verso AI</tspan>
      <tspan x="100" dy="15">Pro</tspan>
    </text>

    <!-- Verso AI Free: 53% => height=127.2, y=152.8 -->
    <rect x="165" y="152.8" width="70" height="133.2" rx="6" ry="6" fill="#1a1a1a" clip-path="url(#clip-bottom)"/>
    <text x="200" y="142.8" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#1a1a1a">53%</text>
    <text x="200" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#1a1a1a">
      <tspan x="200" dy="0">Verso AI</tspan>
      <tspan x="200" dy="15">Free</tspan>
    </text>

    <!-- Claude for PowerPoint: 41% => height=98.4, y=181.6 -->
    <rect x="265" y="181.6" width="70" height="104.4" rx="6" ry="6" fill="#c8c8c8" clip-path="url(#clip-bottom)"/>
    <text x="300" y="171.6" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#999999">41%</text>
    <text x="300" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#999999">
      <tspan x="300" dy="0">Claude for</tspan>
      <tspan x="300" dy="15">PowerPoint</tspan>
    </text>

    <!-- GenSpark: 16% => height=38.4, y=241.6 -->
    <rect x="365" y="241.6" width="70" height="44.4" rx="6" ry="6" fill="#c8c8c8" clip-path="url(#clip-bottom)"/>
    <text x="400" y="231.6" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#999999">16%</text>
    <text x="400" y="302" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#999999">
      <tspan x="400" dy="0">GenSpark</tspan>
      <tspan x="400" dy="15">&nbsp;</tspan>
    </text>
  </svg>
</div>
