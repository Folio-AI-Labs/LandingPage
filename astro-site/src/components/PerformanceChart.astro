---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locales = {
  en: 'en-US',
  fr: 'fr-FR',
  es: 'es-ES',
  de: 'de-DE',
} as const;
const evaluationDateValue = new Date();
const evaluationDate = new Intl.DateTimeFormat(locales[lang], {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(evaluationDateValue);
const evaluationDateIso = evaluationDateValue.toISOString().slice(0, 10);

// ── Pareto scatter (ported from the demo "Faster, Stronger" slide / FrameG4) ──
// Plot area in SVG user units. X = generation time (min, 0..18), Y = score (%, 0..80).
const PLOT = { left: 70, right: 540, top: 30, bottom: 300 };
const FOLIO_BLUE = '#1f4e85';
const ANTHROPIC_PEACH = '#D4A27F';

const xPx = (timeMin: number) =>
  PLOT.left + (timeMin / 18) * (PLOT.right - PLOT.left);
const yPx = (score: number) =>
  PLOT.bottom - (score / 80) * (PLOT.bottom - PLOT.top);

// perf = AVG SCORE (%); time = generation seconds (shown in minutes on the axis).
const folioPoints = [
  { name: 'Folio Max', score: 70.0, time: 138.9, dx: 16, anchor: 'start' as const },
  { name: 'Folio Fast', score: 43.0, time: 90.0, dx: 16, anchor: 'start' as const },
];
const claudePoints = [
  { name: 'Claude', score: 46.9, time: 962.8, dx: -16, anchor: 'end' as const },
];
const toXY = (p: { score: number; time: number }) => ({ x: xPx(p.time / 60), y: yPx(p.score) });

const yTicks = [0, 20, 40, 60, 80];
const xTicks = [3, 15];
---

<div class="w-full max-w-[600px] mx-auto">
  <svg viewBox="0 0 560 340" class="w-full" xmlns="http://www.w3.org/2000/svg" font-family="'ABC Arizona Flare', Georgia, serif">
    <!-- Axes -->
    <line x1={PLOT.left} y1={PLOT.top} x2={PLOT.left} y2={PLOT.bottom} stroke="#aab0b8" stroke-width="2"/>
    <line x1={PLOT.left} y1={PLOT.bottom} x2={PLOT.right} y2={PLOT.bottom} stroke="#aab0b8" stroke-width="2"/>

    <!-- Y ticks + labels -->
    {yTicks.map((s) => (
      <g>
        <line x1={PLOT.left - 6} y1={yPx(s)} x2={PLOT.left} y2={yPx(s)} stroke="#aab0b8" stroke-width="2"/>
        <text x={PLOT.left - 11} y={yPx(s) + 4} text-anchor="end" font-size="13" fill="#28415f">{s}%</text>
      </g>
    ))}
    <!-- Y axis title -->
    <text x="22" y={(PLOT.top + PLOT.bottom) / 2} text-anchor="middle" font-size="15" fill="#28415f"
          transform={`rotate(-90 22 ${(PLOT.top + PLOT.bottom) / 2})`}>Score</text>

    <!-- X ticks + labels -->
    {xTicks.map((time) => (
      <g>
        <line x1={xPx(time)} y1={PLOT.bottom} x2={xPx(time)} y2={PLOT.bottom + 6} stroke="#aab0b8" stroke-width="2"/>
        <text x={xPx(time)} y={PLOT.bottom + 22} text-anchor="middle" font-size="13" fill="#28415f">{time} min</text>
      </g>
    ))}

    <!-- Dashed Pareto frontier joining the two Folio points -->
    <polyline
      points={folioPoints.map((p) => { const c = toXY(p); return `${c.x},${c.y}`; }).join(' ')}
      fill="none" stroke={FOLIO_BLUE} stroke-width="2.5" stroke-dasharray="8 6"/>

    <!-- Claude marker (peach) -->
    {claudePoints.map((p) => { const c = toXY(p); return (
      <g>
        <circle cx={c.x} cy={c.y} r="9" fill={ANTHROPIC_PEACH} stroke="#ffffff" stroke-width="3"/>
        <circle cx={c.x} cy={c.y} r="12" fill="none" stroke={ANTHROPIC_PEACH} stroke-width="1.5"/>
        <text x={c.x + p.dx} y={c.y + 4} text-anchor={p.anchor} font-size="14" font-weight="700" fill={ANTHROPIC_PEACH}>{p.name}</text>
      </g>
    ); })}

    <!-- Folio markers (blue) -->
    {folioPoints.map((p) => { const c = toXY(p); return (
      <g>
        <circle cx={c.x} cy={c.y} r="9" fill={FOLIO_BLUE} stroke="#ffffff" stroke-width="3"/>
        <circle cx={c.x} cy={c.y} r="12" fill="none" stroke={FOLIO_BLUE} stroke-width="1.5"/>
        <text x={c.x + p.dx} y={c.y + 4} text-anchor={p.anchor} font-size="14" font-weight="700" fill={FOLIO_BLUE}>{p.name}</text>
      </g>
    ); })}
  </svg>
  <p class="mt-5 text-center text-sm text-brand-muted">
    {t('models.evaluation')} · <time dateTime={evaluationDateIso}>{evaluationDate}</time>
  </p>
</div>
