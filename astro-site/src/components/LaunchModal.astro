---
// Site-wide launch promo modal. Auto-opens once per visit (sessionStorage),
// shows a live countdown to the Product Hunt launch, and links to the
// /product-hunt-launch/ page. Rendered from Layout on every page except the
// launch page itself.
const LAUNCH_ISO = '2026-06-27T09:00:00+02:00'; // 9:00 CEST (UTC+2 in June)
---

<div id="launch-modal" class="fixed inset-0 z-[2000] hidden items-center justify-center" data-launch={LAUNCH_ISO}>
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-close-launch-modal></div>

  <div class="relative bg-white rounded-2xl shadow-2xl p-8 nav:p-10 max-w-[460px] w-[90%] text-center z-10">
    <button
      data-close-launch-modal
      class="absolute top-4 right-4 text-brand-muted hover:text-brand transition-colors bg-transparent border-none cursor-pointer text-xl leading-none p-1"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    <span class="inline-block font-heading text-sm font-semibold tracking-wide uppercase text-ph-orange bg-ph-orange/10 rounded-pill py-1.5 px-4 mb-5">
      Launching on Product Hunt
    </span>

    <h3 class="font-display text-[28px] nav:text-[32px] font-normal text-brand leading-tight mb-2">
      We go live Saturday, 9am CET
    </h3>
    <p class="text-brand-muted leading-relaxed mb-7">
      A few minutes of your time can land us Product of the Day. Here's how you can help.
    </p>

    <div class="flex justify-center gap-2.5 nav:gap-3 mb-8" aria-live="polite">
      {['days', 'hours', 'minutes', 'seconds'].map(unit => (
        <div class="flex flex-col items-center bg-ph-orange/10 rounded-xl px-3 nav:px-4 py-2.5 min-w-[62px] nav:min-w-[72px]">
          <span data-unit={unit} class="font-display text-2xl nav:text-3xl font-semibold text-ph-orange leading-none tabular-nums">--</span>
          <span class="text-[10px] nav:text-[11px] uppercase tracking-wide text-brand-muted mt-1 font-heading">{unit}</span>
        </div>
      ))}
    </div>

    <a
      href="/product-hunt-launch/"
      class="block w-full bg-ph-orange text-white no-underline font-heading font-semibold py-3.5 px-6 rounded-pill transition duration-300 hover:-translate-y-0.5 hover:shadow-lg"
    >
      See how to support us →
    </a>
  </div>
</div>

<script>
  const modal = document.getElementById('launch-modal');

  if (modal) {
    const target = new Date(modal.dataset.launch!).getTime();
    const out = {
      days: modal.querySelector('[data-unit="days"]')!,
      hours: modal.querySelector('[data-unit="hours"]')!,
      minutes: modal.querySelector('[data-unit="minutes"]')!,
      seconds: modal.querySelector('[data-unit="seconds"]')!,
    };
    const pad = (n: number) => String(n).padStart(2, '0');
    let timer: ReturnType<typeof setInterval>;

    function tick() {
      const diff = target - Date.now();
      if (diff <= 0) {
        out.days.textContent = '0';
        out.hours.textContent = out.minutes.textContent = out.seconds.textContent = '00';
        clearInterval(timer);
        return;
      }
      const s = Math.floor(diff / 1000);
      out.days.textContent = String(Math.floor(s / 86400));
      out.hours.textContent = pad(Math.floor((s % 86400) / 3600));
      out.minutes.textContent = pad(Math.floor((s % 3600) / 60));
      out.seconds.textContent = pad(s % 60);
    }

    function closeModal() {
      modal!.classList.add('hidden');
      modal!.classList.remove('flex');
    }

    modal.querySelectorAll('[data-close-launch-modal]').forEach(el =>
      el.addEventListener('click', closeModal)
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    // Auto-open once per visit, only while the launch is still upcoming.
    const SEEN_KEY = 'phLaunchModalSeen';
    if (target - Date.now() > 0 && !sessionStorage.getItem(SEEN_KEY)) {
      tick();
      timer = setInterval(tick, 1000);
      setTimeout(() => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        sessionStorage.setItem(SEEN_KEY, '1');
      }, 900);
    }
  }
</script>
