---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="mt-auto bg-brand text-white">
  <!-- Main footer content -->
  <div class="max-w-6xl mx-auto px-6 nav:px-12 pt-14 pb-10">
    <div class="grid grid-cols-1 nav:grid-cols-12 gap-10 nav:gap-8">

      <!-- Brand column -->
      <div class="nav:col-span-5">
        <div class="flex items-center gap-3 mb-4">
          <img src="/v_icon_white.svg" alt="Verso AI Logo" class="w-8 h-8" />
          <span class="font-heading text-xl font-semibold text-white">Verso AI</span>
        </div>
        <p class="text-sm text-white/60 leading-relaxed max-w-xs mb-6">
          {t('footer.tagline')}
        </p>
        <div class="flex items-center gap-2 text-sm text-white/50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
          <span>{t('footer.gdpr')}</span>
        </div>
      </div>

      <!-- Product column -->
      <div class="nav:col-span-2 nav:col-start-7">
        <h4 class="font-heading text-xs font-semibold uppercase tracking-wider text-white/40 mb-4">{t('footer.product')}</h4>
        <ul class="space-y-3 list-none p-0 m-0">
          <li><a href={getLocalizedPath('/pricing/', lang)} class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">{t('footer.pricing')}</a></li>
          <li><a href={getLocalizedPath('/demo/', lang)} class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">{t('footer.demo')}</a></li>
        </ul>
      </div>

      <!-- Resources column -->
      <div class="nav:col-span-2">
        <h4 class="font-heading text-xs font-semibold uppercase tracking-wider text-white/40 mb-4">{t('footer.resources')}</h4>
        <ul class="space-y-3 list-none p-0 m-0">
          <li><a href={getLocalizedPath('/blog/', lang)} class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">{t('footer.articles')}</a></li>
          <li><a href={getLocalizedPath('/support/', lang)} class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">{t('footer.support')}</a></li>
        </ul>
      </div>

      <!-- Company column -->
      <div class="nav:col-span-3">
        <h4 class="font-heading text-xs font-semibold uppercase tracking-wider text-white/40 mb-4">{t('footer.company')}</h4>
        <ul class="space-y-3 list-none p-0 m-0">
          <li><a href={getLocalizedPath('/privacy/', lang)} class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">{t('footer.privacyPolicy')}</a></li>
          <li><a href={getLocalizedPath('/terms/', lang)} class="text-sm text-white/70 hover:text-white transition-colors duration-200 no-underline">{t('footer.terms')}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-6 nav:px-12 py-5 flex flex-col nav:flex-row items-center justify-between gap-3">
      <span class="text-xs text-white/40">{t('footer.copyright')}</span>
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/company/verso-ai-slides/" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors duration-200" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
